# separately from the root — see docs/pnpm-workspace.yaml.
docs/dist/
docs/.vitepress-cache/

# The Voltip sub-site, which installs on its own the same way (voltip/README.md).
voltip/dist/
voltip/.vitepress-cache/

# The Lockra sub-site, which installs on its own the same way and is published inside
# firlab.app under /lockra/ (lockra/README.md).
lockra/dist/
lockra/.vitepress-cache/

# The pt-tools sub-site, which installs on its own the same way and is published inside
