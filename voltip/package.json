{
  "name": "voltip-docs",
  "private": true,
  "type": "module",
  "description": "Voltip documentation site, published at https://voltip.firlab.app",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "dev": "vitepress dev src",
    "build": "vitepress build src",
    "preview": "vitepress preview src",
    "test": "vitest run",
    "typecheck": "tsc -p functions/tsconfig.json",
    "functions:dev": "wrangler pages dev dist --d1 DB --compatibility-date=2026-08-01"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260814.1",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "typescript": "5.9.3",
    "vitepress": "1.6.4",
    "vitest": "3.2.4",
    "wrangler": "4.122.0"
  }
}
