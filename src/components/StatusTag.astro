---
import { useTranslations, type Lang } from '../i18n/ui';
import type { Status } from '../i18n/products';

/**
 * StatusTag — maturity, stated as text. Colour reinforces it and never carries it alone
 * (WCAG 1.4.1). The dot may use the brand orange, which is decoration; the label may not,
 * since orange-500 on the sheet measures 2.7:1, so an early release's label is ink and only
 * its dot is orange.
 */
interface Props {
  lang: Lang;
  state: Status;
  class?: string;
}

const { lang, state, class: className = '' } = Astro.props;
const t = useTranslations(lang);
---

<span class={`u-status u-status-${state} ${className}`}>{t(`status.${state}`)}</span>
