---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Wordmark from './Wordmark.astro';
import Icon from './Icon.astro';
import SocialIcon from './SocialIcon.astro';
import ThemeSwitch from './ThemeSwitch.astro';
import LangSwitch from './LangSwitch.astro';
import ProjectGroups from './ProjectGroups.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import type { ProductId } from '../i18n/products';

/**
 * SiteHeader — the sticky bar on every page: the wordmark, the menu in plain words, and
 * the tools at the end of the bar.
 *
 * The menu's first item opens every project at once, a column per category with each
 * project's icon and current version, so the bar's width does not depend on how many
 * projects exist. The other two items lead to the home page's sections. The current
 * section carries a 2px ink line under its word, Voltip's rule: on a product page that is
 * "Projects".
 *
 * Every menu is a `<details>` disclosure, so it opens and closes with scripting off and
 * announces its expanded state natively; the layout's script adds Escape, outside-click
 * and one-open-at-a-time. Below 768px the words give way to one menu button whose sheet
 * holds the same projects and links.
 *
 * The tools: language and theme as icon menus, then the Official Account from 1024px
 * and the ink GitHub pill from 768px. Measured with both shown, the bar ran 19px into the
 * gutter at 768px; the Official Account stays reachable from the hero and the footer.
 */
interface Props {
  lang: Lang;
  /** Set on a product page. */
  currentId?: ProductId;
}

const { lang, currentId } = Astro.props;
const t = useTranslations(lang);

const home = getRelativeLocaleUrl(lang, '');
---

<header class="u-nav">
  <div class="u-shell u-nav-in">
    <a href={home} class="u-brand" aria-label={t('nav.home')}>
      <Wordmark />
    </a>

    <nav class="u-menu" aria-label={t('nav.label')}>
      <details data-popover class:list={['u-menu-projects', currentId && 'is-current']}>
        <summary>
          {t('nav.projects')}
          <Icon name="chevronDown" size={14} strokeWidth={2} />
        </summary>
        <div class="u-pop u-mega">
          <ProjectGroups lang={lang} currentId={currentId} idPrefix="mega" />
          <div class="u-mega-foot">
            <a class="u-link" href={`${home}#projects`}>{t('nav.allProjects')}</a>
            <a class="u-link" href={`${home}#releases`}>{t('nav.releases')}</a>
          </div>
        </div>
      </details>
      <a href={`${home}#releases`}>{t('nav.releases')}</a>
      <a href={`${home}#feedback`}>{t('nav.feedback')}</a>
    </nav>

    <div class="u-tools">
      <LangSwitch lang={lang} />
      <ThemeSwitch lang={lang} />

      <span class="u-nav-sep u-only-xl" aria-hidden="true"></span>
      <details data-popover class="u-only-xl">
        <summary class="u-nav-strong">
          <SocialIcon id="wechat" size={17} />
          {t('nav.wechatOa')}
        </summary>
        <div class="u-pop u-pop-end u-qr">
          {/* White plate in both themes: a scanner needs a light ground. */}
          <img
            src="/wechat-official-account.jpg"
            width="430"
            height="430"
            alt={t('social.wechatOa.alt')}
            loading="lazy"
            decoding="async"
          />
          <p>{t('social.wechatOa.name')} · {t('social.wechatOa.caption')}</p>
        </div>
      </details>

      <a
        class="u-btn u-btn-ink u-btn-sm u-only-wide"
        href="https://github.com/sunerpy"
        target="_blank"
        rel="noopener noreferrer"
      >
        <SocialIcon id="github" size={16} />
        GitHub
      </a>

      {/* The phone menu. Not positioned itself, so its sheet is placed against the bar's
          content column and can use the whole width of a 320px screen. */}
      <details data-popover class="u-burger u-only-narrow">
        <summary class="u-icon-btn" aria-label={t('nav.menu')} title={t('nav.menu')}>
          <Icon name="menu" size={20} />
        </summary>
        <div class="u-pop u-sheet">
          <ProjectGroups lang={lang} currentId={currentId} idPrefix="sheet" />
          <ul class="u-sheet-links">
            <li><a href={`${home}#releases`}>{t('nav.releases')}</a></li>
            <li><a href={`${home}#feedback`}>{t('nav.feedback')}</a></li>
            <li>
              <a href="https://github.com/sunerpy" target="_blank" rel="noopener noreferrer">
                <SocialIcon id="github" size={16} />
                GitHub
              </a>
            </li>
          </ul>
        </div>
      </details>
    </div>
  </div>
</header>
