---
import Wordmark from './Wordmark.astro';

/**
 * SiteHeader — wordmark left, one link right. Not sticky, no centred nav, no
 * CTA button: there is one page and nothing to sign up for.
 */
---

<header class="border-rule border-b">
  <div class="mx-auto flex max-w-[76rem] items-center justify-between px-6 py-6 md:px-10">
    <a href="/" class="text-ink hover:text-ink no-underline" aria-label="FirLab — home">
      <Wordmark />
    </a>
    <a
      href="https://github.com/sunerpy"
      rel="noopener"
      class="u-meta text-ink-mute hover:text-accent no-underline"
    >
      github/sunerpy
    </a>
  </div>
</header>
