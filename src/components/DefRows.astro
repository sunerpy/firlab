---
import type { Row } from '../i18n/voxera';

/**
 * DefRows — a hairline-divided definition list with a wide term column.
 *
 * Deliberately not `SpecGrid`: that one fixes the term column at 9rem, which is
 * right for one-word spec labels and wrong for the sentence-shaped terms a
 * write-up uses ("Wayland: toggle only", "The application · AGPL-3.0-only").
 * Here the term takes a third of the grid and the value keeps a readable
 * measure — roughly 42 hanzi per line at the widest breakpoint, which is the
 * band CJK copy needs.
 *
 * `mono` switches the term from the uppercase mono label to plain monospace at
 * document case: crate names are lowercase identifiers and `uppercase` would
 * misrepresent them.
 */
interface Props {
  items: Row[];
  variant?: 'label' | 'mono';
  class?: string;
}

const { items, variant = 'label', class: className = '' } = Astro.props;

const termClass =
  variant === 'mono'
    ? 'text-ink font-mono text-sm'
    : 'u-meta text-ink-soft pt-0.5';
---

<dl class={`divide-rule u-stagger divide-y ${className}`}>
  {
    items.map((item) => (
      <div class="grid gap-x-8 gap-y-2 py-6 lg:grid-cols-12">
        <dt class={`min-w-0 lg:col-span-4 ${termClass}`}>{item.term}</dt>
        <dd class="text-ink-body min-w-0 text-sm lg:col-span-8">{item.value}</dd>
      </div>
    ))
  }
</dl>
