---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Layout from '../layouts/Layout.astro';
import FloatingNav from './FloatingNav.astro';
import SiteFooter from './SiteFooter.astro';
import NextProduct from './NextProduct.astro';
import ProductMark from './ProductMark.astro';
import StatusTag from './StatusTag.astro';
import SectionHead from './SectionHead.astro';
import DefRows from './DefRows.astro';
import SpecGrid from './SpecGrid.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { getContent } from '../i18n/content';
import { getVoxeraContent } from '../i18n/voxera';

/**
 * Voxera detail page, assembled once and rendered per locale — the same
 * single-source arrangement the home page uses, so a section added to Chinese
 * cannot silently go missing from English.
 *
 * WHAT THIS PAGE DELIBERATELY DOES NOT HAVE
 *
 * No repository link, no releases link, no version number, no install command,
 * no download button, no waitlist, no countdown. Voxera has no public
 * repository and no release; every one of those would either 404 or assert
 * something untrue. There is also no email capture: the site has no backend and
 * no analytics, so a form would go nowhere.
 *
 * The page therefore has to earn the visit on content rather than on a call to
 * action. Its spine is the privacy ledger — three modes, ordered on the single
 * axis of what leaves the machine — flanked by the boundary section (what it
 * refuses to be, and what that costs) and the architecture.
 *
 * Visual restraint is structural, matching how the home page expresses this
 * product's status: the h1 sits at `text-title` rather than `text-display`, the
 * status band and the closing band are bounded by dashed rules, and the whole
 * page contains no filled button. It should read quieter than a released
 * product's page, not broken.
 *
 * Structured data is a `BreadcrumbList` only. A `SoftwareApplication` node here
 * would have to carry either a fabricated version or a URL that does not
 * resolve; the honest move is to assert neither.
 */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const c = getVoxeraContent(lang);

// The nav and footer both take the product index; it comes from the shared
// content module so this page cannot drift out of sync with the home page.
const { products } = getContent(lang);

const homeHref = getRelativeLocaleUrl(lang, '');
const selfHref = getRelativeLocaleUrl(lang, 'voxera/');

const structuredData = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: c.home,
        item: new URL(homeHref, Astro.site).href,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Voxera',
        item: new URL(selfHref, Astro.site).href,
      },
    ],
  },
];

/**
 * Privacy indicator tones. The transmission is always spelled out in words
 * beside the dot, so colour reinforces and never carries the meaning (WCAG
 * 1.4.1). `--color-mark` is the brand orange and appears only as the dot —
 * measured at 2.7:1 on paper, it may not set text.
 */
const tone = {
  none: { dot: 'bg-live', text: 'text-live' },
  third: { dot: 'bg-mark', text: 'text-accent' },
  off: { dot: 'bg-ink-mute', text: 'text-ink-mute' },
} as const;
---

<Layout
  lang={lang}
  title={c.title}
  description={c.description}
  ogImageAlt={c.ogAlt}
  structuredData={structuredData}
>
  <FloatingNav lang={lang} products={products} currentId="voxera" />

  <main id="main" class="u-shell">
    {/* ---- Crumb rail -------------------------------------------------- */}
    <nav aria-label={t('nav.breadcrumb')} class="pt-10 md:pt-14">
      <ol class="u-meta text-ink-mute flex items-center gap-2">
        <li><a href={homeHref} class="text-ink-mute hover:text-accent">{c.home}</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-ink-soft u-display-latin">Voxera</li>
      </ol>
    </nav>

    {/* ---- Hero -------------------------------------------------------- */}
    <header class="grid gap-y-10 pt-10 pb-14 md:pt-14 md:pb-20 lg:grid-cols-12 lg:gap-x-8">
      <div class="min-w-0 lg:col-span-8">
        <p class="u-meta text-ink-mute">{c.eyebrow}</p>
        <h1 class="u-display u-display-latin text-title mt-6">{c.headline}</h1>
        <p class="text-ink-soft mt-4 font-mono text-sm">{c.role}</p>
        <p class="u-lede text-ink-body mt-8 max-w-[40rem]">{c.lede}</p>
      </div>

      <aside class="min-w-0 lg:col-span-3 lg:col-start-10">
        <span class="inline-flex" style="view-transition-name: mark-voxera">
          <ProductMark product="voxera" size={92} class="text-ink-soft" />
        </span>
        <StatusTag lang={lang} state="wip" display="block" class="mt-7" />
        <dl class="border-rule u-stagger mt-6 space-y-4 border-t pt-6">
          {
            c.heroFacts.map((fact) => (
              <div>
                <dt class="u-meta text-ink-mute">{fact.term}</dt>
                <dd class="text-ink-soft mt-1 text-sm">{fact.value}</dd>
              </div>
            ))
          }
        </dl>
      </aside>
    </header>

    {/* ---- Status ------------------------------------------------------
        Dashed boundary, carried over from how the home page marks this
        product: the rule itself says "not finished" before a label is read. */}
    <section class="border-rule u-reveal border-t border-dashed py-14 md:py-16">
      <div class="grid gap-y-8 lg:grid-cols-12 lg:gap-x-8">
        <div class="min-w-0 lg:col-span-5">
          <SectionHead label={c.status.label} heading={c.status.heading} />
        </div>
        <div class="min-w-0 lg:col-span-7">
          <p class="text-ink-body max-w-[42rem]">{c.statusBody}</p>
        </div>
      </div>
      <DefRows items={c.statusRows} class="border-rule mt-12 border-t" />
    </section>

    {/* ---- The loop ---------------------------------------------------- */}
    <section class="border-rule u-reveal mt-10 border-t py-14 md:mt-20 md:py-20">
      <SectionHead label={c.loop.label} heading={c.loop.heading} intro={c.loop.intro} />
      <ol class="u-stagger mt-12 grid gap-y-10 lg:grid-cols-3 lg:gap-x-8">
        {
          c.steps.map((step) => (
            <li class="border-rule min-w-0 border-t pt-6">
              <div class="flex items-baseline gap-4">
                <span class="u-meta text-ink-mute tabular-nums">{step.index}</span>
                <h3 class="text-ink text-[1.0625rem] font-medium">{step.term}</h3>
              </div>
              <p class="text-ink-body mt-4 text-sm">{step.value}</p>
            </li>
          ))
        }
      </ol>
    </section>

    {/* ---- Boundaries -------------------------------------------------- */}
    <section class="border-rule u-reveal mt-10 border-t py-14 md:mt-20 md:py-20">
      <SectionHead
        label={c.negations.label}
        heading={c.negations.heading}
        intro={c.negations.intro}
      />
      <ol class="divide-rule u-stagger border-rule mt-12 divide-y border-t">
        {
          c.negationItems.map((item, i) => (
            <li class="grid gap-x-8 gap-y-3 py-8 lg:grid-cols-12">
              <div class="flex min-w-0 items-baseline gap-4 lg:col-span-4">
                <span class="u-meta text-ink-mute tabular-nums">{`0${i + 1}`}</span>
                <h3 class="u-display text-[1.25rem]">{item.term}</h3>
              </div>
              <p class="text-ink-body min-w-0 text-sm lg:col-span-8">{item.value}</p>
            </li>
          ))
        }
      </ol>
      <p class="text-ink-body mt-10 max-w-[42rem] text-sm">{c.negationClose}</p>
    </section>

    {/* ---- Privacy ledger ----------------------------------------------
        The spine of the page. One axis only: what is transmitted. The tone
        dot reinforces; the words carry it. */}
    <section class="border-rule u-reveal mt-10 border-t py-14 md:mt-20 md:py-20">
      <SectionHead label={c.privacy.label} heading={c.privacy.heading} intro={c.privacy.intro} />

      <ul class="divide-rule u-stagger border-rule mt-12 divide-y border-t">
        {
          c.privacyModes.map((mode) => (
            <li class="grid gap-x-8 gap-y-4 py-8 lg:grid-cols-[13rem_12rem_minmax(0,1fr)]">
              <h3 class="text-ink flex min-w-0 items-start gap-2.5 text-[0.9375rem] font-medium">
                <span
                  class={`mt-[0.55em] block size-1.5 shrink-0 rounded-full ${tone[mode.tone].dot}`}
                  aria-hidden="true"
                />
                {mode.name}
              </h3>

              <div class="min-w-0">
                <p class="u-meta text-ink-mute">{c.privacyTransmitLabel}</p>
                <p class={`mt-1.5 font-mono text-sm ${tone[mode.tone].text}`}>{mode.sends}</p>
              </div>

              <p class="text-ink-body min-w-0 text-sm">{mode.detail}</p>
            </li>
          ))
        }
      </ul>

      <p class="text-ink-body bg-panel border-rule mt-10 max-w-[46rem] border-l px-6 py-5 text-sm">
        {c.privacyDefaults}
      </p>
    </section>

    {/* ---- Control ----------------------------------------------------- */}
    <section class="border-rule u-reveal border-t py-14 md:py-20">
      <SectionHead label={c.control.label} heading={c.control.heading} intro={c.control.intro} />
      <DefRows items={c.controlRows} class="border-rule mt-12 border-t" />
    </section>

    {/* ---- Architecture ------------------------------------------------ */}
    <section class="border-rule u-reveal mt-10 border-t py-14 md:mt-20 md:py-20">
      <SectionHead label={c.arch.label} heading={c.arch.heading} intro={c.arch.intro} />
      <DefRows items={c.crates} variant="mono" class="border-rule mt-12 border-t" />
      <p class="text-ink-body mt-10 max-w-[42rem] text-sm">{c.archNote}</p>

      <div class="border-rule mt-12 border-t pt-8">
        <h3 class="u-meta text-ink-mute">{c.stackLabel}</h3>
        <SpecGrid items={c.stackRows} class="mt-6" />
      </div>
    </section>

    {/* ---- Platform ---------------------------------------------------- */}
    <section class="border-rule u-reveal border-t py-10 md:py-14">
      <SectionHead label={c.platform.label} heading={c.platform.heading} intro={c.platform.intro} />
      <DefRows items={c.platformRows} class="border-rule mt-12 border-t" />
    </section>

    {/* ---- Licence ----------------------------------------------------- */}
    <section class="border-rule u-reveal border-t py-10 md:py-14">
      <SectionHead label={c.licence.label} heading={c.licence.heading} intro={c.licence.intro} />
      <DefRows items={c.licenceRows} class="border-rule mt-12 border-t" />
    </section>

    {/* ---- Close -------------------------------------------------------
        No call to action, because there is nothing to act on. What the
        visitor gets instead is an honest ending and two tools that do
        exist today. */}
    <section class="border-rule u-reveal mt-10 border-t border-dashed py-14 md:mt-20 md:py-20">
      <div class="grid gap-y-10 lg:grid-cols-12 lg:gap-x-8">
        <div class="min-w-0 lg:col-span-7">
          <SectionHead label={c.close.label} heading={c.close.heading} />
          <p class="text-ink-body mt-6 max-w-[42rem]">{c.closeBody}</p>
          <p class="mt-8 text-sm">
            <a href={homeHref}>{c.backHome}</a>
          </p>
        </div>

        <div class="min-w-0 lg:col-span-4 lg:col-start-9">
          <h2 class="u-meta text-ink-mute">{c.siblingsLabel}</h2>
          <ul class="divide-rule u-stagger border-rule mt-5 divide-y border-t">
            {
              c.siblings.map((sibling) => (
                <li class="py-5">
                  <a
                    href={getRelativeLocaleUrl(lang, `${sibling.id}/`)}
                    class="u-display-latin font-mono text-sm"
                  >
                    {sibling.name}
                  </a>
                  <p class="text-ink-mute mt-1 font-mono text-xs">{sibling.role}</p>
                  <p class="text-ink-body mt-3 text-sm">{sibling.detail}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>
  </main>

  <NextProduct lang={lang} products={products} currentId="voxera" />

  <SiteFooter lang={lang} products={products} variant="detail" currentId="voxera" />
</Layout>
