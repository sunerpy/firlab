---
import type { SectionMeta } from '../i18n/agentlens';

/**
 * DetailSection — one numbered band on a product detail page.
 *
 * `layout`:
 *   text  prose measure, 7 of 12 columns — the default.
 *   wide  9 of 12 columns, for figures and tables that need the width.
 *
 * `rhythm` maps onto the shared `.u-band*` vocabulary in global.css, and the
 * mapping is the point: only `open` draws a rule. Ten sections each opening
 * with the same hairline made the rule mean nothing, so a rule now marks a
 * movement and `next` / `tight` are separated by space alone.
 */
interface Props {
  section: SectionMeta;
  layout?: 'text' | 'wide';
  rhythm?: 'open' | 'next' | 'tight';
}

const { section, layout = 'text', rhythm = 'next' } = Astro.props;

const body = layout === 'wide' ? 'lg:col-span-9 lg:col-start-4' : 'lg:col-span-7 lg:col-start-4';

const gap = {
  open: 'u-band-open',
  next: 'u-band-next',
  tight: 'u-band-tight',
}[rhythm];
---

<section
  id={section.id}
  aria-labelledby={`${section.id}-heading`}
  class={`u-reveal u-band grid gap-y-6 lg:grid-cols-12 lg:gap-x-10 ${gap}`}
>
  <div class="flex items-baseline gap-4 lg:col-span-3 lg:flex-col lg:gap-2 lg:pt-1.5">
    {/* `text-accent`, not the brand orange: this is text, and #F97316 measures
        2.7:1 on paper. The orange is reserved for marks, dots and the one
        left rule that means "this is the claim". */}
    <span class="u-meta text-accent tabular-nums">{section.num}</span>
    <span class="u-meta text-ink-mute">{section.label}</span>
  </div>

  <div class={`min-w-0 ${body}`}>
    <h2 id={`${section.id}-heading`} class="u-display text-title-sm">{section.heading}</h2>
    <slot />
  </div>
</section>
