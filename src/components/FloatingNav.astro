---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Wordmark from './Wordmark.astro';
import SocialRow from './SocialRow.astro';
import LangSwitch from './LangSwitch.astro';
import ThemeSwitch from './ThemeSwitch.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import type { Product, ProductId } from '../i18n/content';

/**
 * Floating navigation.
 *
 * `position: sticky` on a shell inset from the top edge, so the bar reads as an
 * object on the page rather than a browser chrome strip. It settles — ground
 * opacity up, hairline in, shadow in — as the page scrolls, driven by
 * `animation-timeline: scroll(root)` in global.css. No scroll listener exists.
 *
 * **A product name is a link to that product's page.** It used to be an in-page
 * anchor (`/#codegraph`), which meant clicking CodeGraph scrolled the home page
 * to the CodeGraph band and left the reader to keep scrolling into the other
 * three — the detail page was only reachable from a secondary "详细介绍" link.
 * The name is the primary affordance, so it now points at the primary
 * destination, and it does so in the *current* locale: on `/en/` the entries
 * lead to `/en/codegraph/`, never back to the Chinese page.
 *
 * On a detail page the entry for the product being read is not a link to itself.
 * It is a marked `aria-current="page"` span, the same treatment the detail-page
 * footer strip uses.
 *
 * Progressive disclosure rather than a squashed desktop bar. Each threshold is
 * the width the group MEASURABLY fits at, not a round number:
 *   under 1024px  wordmark + theme + language switch
 *   1024px and up + product links
 *   1280px and up + social icons
 *
 * The social row moved up from `sm` (640px) because the stage narrowed the pill:
 * at 1024px the pill is 856px wide with 828px usable, and wordmark + four
 * product links + socials + theme + language needs 851px — a 23px overflow, i.e.
 * the right-hand cluster rendered outside its own rounded ground. Dropping the
 * socials to `xl` leaves 177px of slack at 1024px and 174px at 1280px where they
 * return. Verified in the browser at 1024 / 1180 / 1280 / 1440.
 *
 * Nothing becomes unreachable at any width: the product links are also the
 * hero's index, and all five socials are repeated WITH text labels in the
 * footer — which is also where their accessible names are least dependent on
 * `aria-label` (DESIGN.md §6). Moving them off the phone bar is a net a11y gain.
 */
interface Props {
  lang: Lang;
  products: Product[];
  /** Set on a product detail page. Marks that entry as the current page. */
  currentId?: ProductId;
}

const { lang, products, currentId } = Astro.props;
const t = useTranslations(lang);

const home = getRelativeLocaleUrl(lang, '');
---

{/* `<header>` rather than a `<div>`: this is the page's banner landmark, and it was
    missing on every page — DESIGN.md §6 claimed the site had one. `<header>` maps
    to `role="banner"` only when it is not nested inside `article`/`section`/`main`,
    which is why it is the outermost element here. */}
<header class="pointer-events-none sticky top-0 z-40 pt-3 md:pt-4">
  <div class="u-shell u-shell-nav pointer-events-auto">
    {/* No horizontal padding utility here on purpose: `.u-nav-shell` owns it via
        `--nav-pad`, which `.u-shell-nav` also reads to pull the pill outward by
        exactly that amount. That is what lands the wordmark on the copy's start
        line, and a utility here would break the pair.

        `flex-nowrap` is the single-line guarantee — a two-line nav at desktop is
        a broken bar, so groups disappear at measured thresholds instead. */}
    <nav
      aria-label={t('nav.label')}
      class="u-nav-shell flex flex-nowrap items-center gap-2 rounded-[var(--radius-control)] py-2 sm:gap-4 md:py-2.5"
    >
      <a
        href={home}
        class="text-ink hover:text-ink shrink-0 no-underline"
        aria-label={t('nav.home')}
      >
        <Wordmark />
      </a>

      <ul class="hidden min-w-0 items-center gap-0.5 lg:flex">
        {
          products.map((product) =>
            product.id === currentId ? (
              <li>
                <span
                  aria-current="page"
                  class="bg-block text-ink u-display-latin inline-flex items-center gap-2 rounded-[var(--radius-chip)] px-2.5 py-1.5 font-mono text-[0.8125rem] whitespace-nowrap"
                >
                  <span aria-hidden="true" class="bg-mark size-1.5 rounded-full" />
                  {product.name}
                </span>
              </li>
            ) : (
              <li>
                <a
                  href={getRelativeLocaleUrl(lang, product.detail)}
                  class="text-ink-mute hover:text-accent hover:bg-panel u-display-latin rounded-[var(--radius-chip)] px-2.5 py-1.5 font-mono text-[0.8125rem] whitespace-nowrap no-underline"
                >
                  {product.name}
                </a>
              </li>
            ),
          )
        }
      </ul>

      <div class="ml-auto flex shrink-0 items-center gap-2.5">
        <SocialRow lang={lang} variant="nav" placement="below" class="hidden xl:flex" />
        <ThemeSwitch lang={lang} />
        <LangSwitch lang={lang} />
      </div>
    </nav>
  </div>
</header>
