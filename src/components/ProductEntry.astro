---
import { getRelativeLocaleUrl } from 'astro:i18n';
import ProductMark from './ProductMark.astro';
import StatusTag from './StatusTag.astro';
import SpecGrid from './SpecGrid.astro';
import InstallBlock from './InstallBlock.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import type { Product } from '../i18n/content';

/**
 * ProductEntry — one band in the editorial index.
 *
 * Layout: narrow left rail (index + mark) · wide main column · right meta
 * column. Deliberately NOT one of three equal cards: `weight` scales the
 * title, drops the install block and softens the body so a visitor scanning
 * only the rail can tell which tool is usable today.
 *
 * One in-site affordance per band, and it is the name. The heading is the link
 * to the product's page, marked with the site's trailing arrow; the band under
 * it is the summary, read where it stands. The meta column therefore holds
 * *external* destinations only — the old "详细介绍" item there was a second,
 * quieter route to the same page, which is what taught readers that the name
 * was not the way in.
 */
interface Props {
  lang: Lang;
  product: Product;
}

const { lang, product } = Astro.props;
const t = useTranslations(lang);

const { weight } = product;

const titleSize = {
  lead: 'text-title',
  major: 'text-title-md',
  standard: 'text-title-sm',
  pending: 'text-[1.5rem]',
}[weight];

// The pending entry is separated by a dashed rule — the boundary itself says
// "not finished" before any label is read.
const topRule = weight === 'pending' ? 'border-t border-dashed' : 'border-t';

const bodyTone = weight === 'pending' ? 'text-ink-mute' : 'text-ink-body';
const pad = weight === 'lead' ? 'py-14 md:py-20' : 'py-14 md:py-16';

const detailHref = getRelativeLocaleUrl(lang, product.detail);
const links = product.links ?? [];
---

<article
  id={product.id}
  class={`border-rule u-reveal ${topRule} ${pad} grid gap-y-8 lg:grid-cols-12 lg:gap-x-8`}
>
  {/* Rail — index number and mark. Horizontal on small screens.

      The mark and the title carry `view-transition-name`s that the matching
      detail page repeats, so the cross-document transition morphs this entry
      into that page's masthead instead of cross-fading two whole documents. The
      names are derived from the product id, so a product added later is covered
      without touching this file. */}
  <div class="flex items-center gap-4 lg:col-span-2 lg:items-start lg:pt-1">
    <span class="u-meta text-ink-mute tabular-nums">{product.index}</span>
    <span class="inline-flex" style={`view-transition-name: mark-${product.id}`}>
      <ProductMark product={product.id} size={weight === 'lead' ? 46 : 38} class="text-ink-soft" />
    </span>
  </div>

  {/* Main column */}
  <div class="min-w-0 lg:col-span-6">
    <h2
      class={`u-display u-display-latin ${titleSize}`}
      style={`view-transition-name: title-${product.id}`}
    >
      <a href={detailHref} class="u-arrow-host text-ink hover:text-accent no-underline"
        >{product.name}<span
          aria-hidden="true"
          class="u-arrow text-ink-mute ml-3 inline-block align-middle text-[0.4em]">→</span
        ></a
      >
    </h2>
    <p class="text-ink-soft mt-3 font-mono text-sm">{product.role}</p>

    <p class={`mt-6 max-w-prose ${bodyTone}`}>{product.body}</p>

    <SpecGrid items={product.specs} class="border-rule mt-10 border-t pt-8" />

    {product.install && <InstallBlock lang={lang} label={product.install.label} lines={product.install.lines} />}
  </div>

  {/* Meta column */}
  <div class="min-w-0 lg:col-span-3 lg:col-start-10">
    <StatusTag lang={lang} state={product.status} />

    {
      (product.version || product.released) && (
        <dl class="mt-6 space-y-3">
          {product.version && (
            <div>
              <dt class="u-meta text-ink-mute">{t('product.version')}</dt>
              <dd class="text-ink-soft font-mono text-sm tabular-nums">{product.version}</dd>
            </div>
          )}
          {product.released && (
            <div>
              <dt class="u-meta text-ink-mute">{t('product.released')}</dt>
              <dd class="text-ink-soft font-mono text-sm tabular-nums">{product.released}</dd>
            </div>
          )}
        </dl>
      )
    }

    {
      links.length > 0 && (
        <ul class="mt-6 space-y-2 text-sm">
          {links.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noopener noreferrer">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }

    {product.note && <p class="text-ink-mute mt-6 max-w-[22rem] text-sm">{product.note}</p>}
  </div>
</article>
