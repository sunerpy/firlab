---
import { getRelativeLocaleUrl } from 'astro:i18n';
import ProductMark from './ProductMark.astro';
import StatusTag from './StatusTag.astro';
import SpecGrid from './SpecGrid.astro';
import InstallBlock from './InstallBlock.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import type { Product } from '../i18n/content';

/**
 * ProductEntry — one entry in the index, in one of FOUR STRUCTURALLY DISTINCT
 * SHAPES. This is the component the whole page's information design rests on.
 *
 * The previous build expressed maturity through four scalar knobs — title size,
 * mark size, body colour, one dashed rule — applied to one identical
 * rail / main / meta grid. Four bands of the same shape in the same three
 * columns read as four rows of a table with the type set slightly differently,
 * which is why a reader could not tell from a glance at the page which tool was
 * usable today. Maturity has to change the SHAPE, or it is decoration.
 *
 *   lead      Full width, no rail. A `.u-plate-lead` masthead — the brand-orange
 *             left rule, which appears in exactly one other place on the site
 *             (a detail page's premise) — carrying mark, title, role and the
 *             release facts on one ground. Specs run two-up across the full
 *             measure; the install block and the outward links close it. The
 *             most-released tool is the only entry that gets a masthead.
 *   major     A 4/7 split: an identity rail (mark, title, status, version,
 *             links) against a reading column (prose, ruled specs, install).
 *             Recognisably a documented product, deliberately not a masthead.
 *   standard  One header line — mark, title, role, status inline — then prose
 *             and unruled specs two-up beneath it. No meta column at all: a
 *             v0.0.5 tool has three facts, and a column drawn for eight makes
 *             the three look like omissions.
 *   pending   A `.u-plate-draft` enclosure: dashed on all four sides, no ground,
 *             no shadow, muted body, no install block, no version, no link. It
 *             reads as a record of intent, which is exactly what it is. The
 *             dashed boundary states that before a word of it is read.
 *
 * One in-site affordance per entry, and it is the name. The heading is the link
 * to the product's page, marked with the site's trailing arrow; everything
 * around it is the summary, read where it stands. The links are therefore
 * *external* destinations only.
 *
 * The mark sits OUTSIDE the link, as a sibling, and is lit by `.u-entry:has()`
 * when the name is hovered or focused — so the mark reads as belonging to the
 * destination rather than as decoration beside it, without making a 500px band
 * into a hover target.
 *
 * `view-transition-name` on the mark and the title is repeated by the matching
 * detail page's masthead, so arriving there morphs this entry rather than
 * cross-fading two documents. Derived from the id, so a fifth product is
 * covered without touching this file.
 */
interface Props {
  lang: Lang;
  product: Product;
}

const { lang, product } = Astro.props;
const t = useTranslations(lang);

const { weight } = product;
const detailHref = getRelativeLocaleUrl(lang, product.detail);
const links = product.links ?? [];

const markName = `view-transition-name: mark-${product.id}`;
const titleName = `view-transition-name: title-${product.id}`;

const LINK_ROW = 'flex flex-wrap items-center gap-x-6 gap-y-2 text-sm';
---

{
  weight === 'lead' && (
    <article id={product.id} class="u-entry u-reveal u-band u-band-open">
      <div class="u-plate u-plate-lead">
        <div class="flex flex-wrap items-start justify-between gap-x-8 gap-y-6">
          <div class="flex min-w-0 items-start gap-5">
            <span class="mt-1 inline-flex shrink-0" style={markName}>
              <ProductMark product={product.id} size={46} class="text-ink-soft u-entry-mark" />
            </span>
            <div class="min-w-0">
              <p class="u-meta text-ink-mute mb-3 tabular-nums">{product.index}</p>
              <h2 class="u-display u-display-latin text-title" style={titleName}>
                <a
                  href={detailHref}
                  class="u-entry-name u-arrow-host text-ink hover:text-accent no-underline"
                >
                  {product.name}
                  <span
                    aria-hidden="true"
                    class="u-arrow text-ink-mute ml-3 inline-block align-middle text-[0.4em]"
                  >
                    →
                  </span>
                </a>
              </h2>
              <p class="text-ink-soft mt-3 font-mono text-sm">{product.role}</p>
            </div>
          </div>

          <div class="shrink-0">
            <StatusTag lang={lang} state={product.status} display="block" />

            <dl class="mt-5 flex flex-wrap items-baseline gap-x-8 gap-y-3">
              <div>
                <dt class="u-meta text-ink-mute">{t('product.version')}</dt>
                <dd class="text-ink-soft mt-1 font-mono text-sm tabular-nums">{product.version}</dd>
              </div>
              <div>
                <dt class="u-meta text-ink-mute">{t('product.released')}</dt>
                <dd class="text-ink-soft mt-1 font-mono text-sm tabular-nums">
                  {product.released}
                </dd>
              </div>
            </dl>
          </div>
        </div>

        <p class="text-ink-body u-measure mt-8">{product.body}</p>
      </div>

      <SpecGrid items={product.specs} variant="grid" class="mt-10" />

      {product.install && (
        <div class="grid gap-x-10 lg:grid-cols-2">
          <InstallBlock lang={lang} label={product.install.label} lines={product.install.lines} />
        </div>
      )}

      {links.length > 0 && (
        <ul class={`border-rule mt-10 border-t pt-6 ${LINK_ROW}`}>
          {links.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noopener noreferrer">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      )}
    </article>
  )
}

{
  weight === 'major' && (
    <article
      id={product.id}
      class="u-entry u-reveal u-band u-band-open grid gap-y-8 lg:grid-cols-12 lg:gap-x-10"
    >
      <div class="min-w-0 lg:col-span-4">
        <p class="u-meta text-ink-mute mb-4 tabular-nums">{product.index}</p>

        <span class="inline-flex" style={markName}>
          <ProductMark product={product.id} size={40} class="text-ink-soft u-entry-mark" />
        </span>

        <h2 class="u-display u-display-latin text-title-md mt-5" style={titleName}>
          <a
            href={detailHref}
            class="u-entry-name u-arrow-host text-ink hover:text-accent no-underline"
          >
            {product.name}
            <span
              aria-hidden="true"
              class="u-arrow text-ink-mute ml-2.5 inline-block align-middle text-[0.4em]"
            >
              →
            </span>
          </a>
        </h2>

        <p class="text-ink-soft mt-3 font-mono text-sm">{product.role}</p>

        <StatusTag lang={lang} state={product.status} display="block" class="mt-6" />

        <dl class="divide-rule border-rule mt-6 divide-y border-t border-b">
          {product.version && (
            <div class="flex items-baseline justify-between gap-4 py-2.5">
              <dt class="u-meta text-ink-mute shrink-0">{t('product.version')}</dt>
              <dd class="text-ink-soft font-mono text-sm tabular-nums">{product.version}</dd>
            </div>
          )}
          {product.released && (
            <div class="flex items-baseline justify-between gap-4 py-2.5">
              <dt class="u-meta text-ink-mute shrink-0">{t('product.released')}</dt>
              <dd class="text-ink-soft font-mono text-sm tabular-nums">{product.released}</dd>
            </div>
          )}
        </dl>

        {links.length > 0 && (
          <ul class={`mt-6 ${LINK_ROW}`}>
            {links.map((link) => (
              <li>
                <a href={link.href} target="_blank" rel="noopener noreferrer">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>

      <div class="min-w-0 lg:col-span-7 lg:col-start-6">
        <p class="text-ink-body u-measure">{product.body}</p>

        <SpecGrid items={product.specs} variant="rows" class="border-rule mt-8 border-t" />

        {product.install && (
          <InstallBlock lang={lang} label={product.install.label} lines={product.install.lines} />
        )}
      </div>
    </article>
  )
}

{
  weight === 'standard' && (
    <article id={product.id} class="u-entry u-reveal u-band u-band-next">
      <div class="flex flex-wrap items-baseline gap-x-5 gap-y-3">
        <span class="u-meta text-ink-mute tabular-nums">{product.index}</span>

        <span class="inline-flex self-center" style={markName}>
          <ProductMark product={product.id} size={30} class="text-ink-soft u-entry-mark" />
        </span>

        <h2 class="u-display u-display-latin text-title-sm min-w-0" style={titleName}>
          <a
            href={detailHref}
            class="u-entry-name u-arrow-host text-ink hover:text-accent no-underline"
          >
            {product.name}
            <span
              aria-hidden="true"
              class="u-arrow text-ink-mute ml-2.5 inline-block align-middle text-[0.4em]"
            >
              →
            </span>
          </a>
        </h2>

        <StatusTag lang={lang} state={product.status} class="ml-auto" />

        {product.version && (
          <span class="text-ink-mute font-mono text-sm tabular-nums">{product.version}</span>
        )}
      </div>

      <p class="text-ink-soft mt-3 font-mono text-sm">{product.role}</p>

      <div class="mt-7 grid gap-x-10 gap-y-7 lg:grid-cols-12">
        <p class="text-ink-body u-measure min-w-0 lg:col-span-5">{product.body}</p>
        <SpecGrid items={product.specs} variant="plain" class="min-w-0 lg:col-span-6 lg:col-start-7" />
      </div>

      {links.length > 0 && (
        <ul class={`mt-8 ${LINK_ROW}`}>
          {links.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noopener noreferrer">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      )}
    </article>
  )
}

{
  weight === 'pending' && (
    <article id={product.id} class="u-entry u-reveal u-band u-band-next">
      <div class="u-plate-draft">
        <div class="flex flex-wrap items-baseline gap-x-5 gap-y-3">
          <span class="u-meta text-ink-mute tabular-nums">{product.index}</span>

          <span class="inline-flex self-center" style={markName}>
            <ProductMark product={product.id} size={26} class="text-ink-mute u-entry-mark" />
          </span>

          <h2 class="u-display u-display-latin text-[1.45rem]" style={titleName}>
            <a
              href={detailHref}
              class="u-entry-name u-arrow-host text-ink-soft hover:text-accent no-underline"
            >
              {product.name}
              <span
                aria-hidden="true"
                class="u-arrow text-ink-mute ml-2.5 inline-block align-middle text-[0.45em]"
              >
                →
              </span>
            </a>
          </h2>

          <StatusTag lang={lang} state={product.status} class="ml-auto" />
        </div>

        <p class="text-ink-mute mt-3 font-mono text-sm">{product.role}</p>

        <p class="text-ink-mute u-measure mt-6 text-sm">{product.body}</p>

        <SpecGrid items={product.specs} variant="plain" class="mt-7" />

        {product.note && (
          <p class="text-ink-mute border-rule u-measure mt-7 border-t border-dashed pt-5 text-sm">
            {product.note}
          </p>
        )}
      </div>
    </article>
  )
}
