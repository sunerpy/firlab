---
/**
 * Wordmark — typographic, not a logo file. The bracket glyph is the site's
 * only ornament: three arms of decreasing length off one spine, which is the
 * same three-tools-at-three-maturities idea the page body is built on.
 */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<span class={`inline-flex items-baseline gap-2.5 ${className}`}>
  <svg
    width="18"
    height="18"
    viewBox="0 0 18 18"
    fill="none"
    aria-hidden="true"
    class="translate-y-[2px]"
  >
    <path d="M3 2 L3 16" stroke="currentColor" stroke-width="2" stroke-linecap="square"></path>
    <path d="M3 4.5 L15 4.5" stroke="var(--color-mark)" stroke-width="2" stroke-linecap="square"
    ></path>
    <path d="M3 9 L11 9" stroke="currentColor" stroke-width="2" stroke-linecap="square"></path>
    <path
      d="M3 13.5 L8 13.5"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="square"
      opacity="0.45"></path>
  </svg>
  <span class="font-mono text-sm font-medium tracking-[0.14em] uppercase">FirLab</span>
</span>
