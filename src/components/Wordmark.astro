---
/**
 * Wordmark — typographic, not a logo file. The bracket glyph is the site's mark: one
 * spine with arms of decreasing length, the top one in the brand orange; the name beside
 * it is set in the text face. Styled by `.u-brand` on the link around it.
 */
interface Props {
  /** Rendered size of the glyph in px. */
  size?: number;
}

const { size = 20 } = Astro.props;
---

<svg class="u-glyph" width={size} height={size} viewBox="0 0 18 18" fill="none" aria-hidden="true">
  <path d="M3 2 L3 16" stroke="currentColor" stroke-width="2" stroke-linecap="square"></path>
  <path d="M3 4.5 L15 4.5" stroke="var(--color-mark)" stroke-width="2" stroke-linecap="square"></path>
  <path d="M3 9 L11 9" stroke="currentColor" stroke-width="2" stroke-linecap="square"></path>
  <path d="M3 13.5 L8 13.5" stroke="currentColor" stroke-width="2" stroke-linecap="square" opacity="0.45"
  ></path>
</svg>
<span>FirLab</span>
