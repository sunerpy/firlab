---
/**
 * Wordmark — typographic, not a logo file. The bracket glyph is the site's mark:
 * one spine with arms of decreasing length, the top one in the brand orange.
 *
 * `compact` lets the header drop the letters below 420px, where the bar has to fit
 * the app menu and both segmented controls. Measured, the English bar needs 355px
 * of column with the letters shown, which a 400px window with a classic 15px
 * scrollbar does not have. The glyph stays, and the link around it carries the
 * accessible name.
 */
interface Props {
  class?: string;
  compact?: boolean;
}

const { class: className = '', compact = false } = Astro.props;
---

<span class={`inline-flex items-center gap-2.5 ${className}`}>
  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
    <path d="M3 2 L3 16" stroke="currentColor" stroke-width="2" stroke-linecap="square"></path>
    <path d="M3 4.5 L15 4.5" stroke="var(--color-mark)" stroke-width="2" stroke-linecap="square"
    ></path>
    <path d="M3 9 L11 9" stroke="currentColor" stroke-width="2" stroke-linecap="square"></path>
    <path
      d="M3 13.5 L8 13.5"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="square"
      opacity="0.45"></path>
  </svg>
  <span
    class:list={[
      'font-mono text-sm font-semibold tracking-[0.14em] uppercase',
      compact && 'max-[420px]:sr-only',
    ]}
  >
    FirLab
  </span>
</span>
