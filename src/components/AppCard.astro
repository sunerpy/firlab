---
import AppIcon from './AppIcon.astro';
import Icon from './Icon.astro';
import StatusTag from './StatusTag.astro';
import SocialIcon from './SocialIcon.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { hasInSitePage, productHref, productKind, sortedPlatforms, type Product } from '../i18n/products';
import { captureFor, showcase } from '../i18n/showcase';

/**
 * AppCard — one project in the catalog grid. Every project gets the same card: the
 * catalog has to absorb a new one without anyone designing a new shape for it.
 *
 * The well at the top shows the project itself: a real capture of the app, or the lines
 * of a real session for a project with no window of its own (`showcase.ts`). The capture
 * starts 20px in from the well's top-left corner and runs off its other two edges, so it
 * keeps one real corner and needs no frame beyond a hairline. Both takes are in the
 * markup and the theme picks one; the other is `display: none`, which a lazy image is
 * never fetched for.
 *
 * The whole card is one target, through a stretched link on the name, so there is
 * exactly one anchor per destination and its accessible name is the project name. The
 * GitHub link sits above the stretch, which keeps it a separate, working control instead
 * of a link nested in a link.
 *
 * The icon and the name carry `view-transition-name`s matching the product page's
 * header, so opening an in-site page morphs the card into it. Projects whose name leads
 * to a separate site get no names — there is nothing to morph into.
 */
interface Props {
  lang: Lang;
  product: Product;
}

const { lang, product } = Astro.props;
const t = useTranslations(lang);

const href = productHref(lang, product);
const morph = hasInSitePage(product);
const platforms = sortedPlatforms(product)
  .map((platform) => t(`platform.${platform}`))
  .join(' · ');
const capture = captureFor(product.id, lang);
const entry = showcase[product.id];

// A session is built as one string because it sits in a `<pre>`, where the template's
// own indentation would become part of the text.
const esc = (text: string) => text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const session =
  'session' in entry
    ? entry.session
        .map((line) => {
          switch (line.kind) {
            case 'cmd':
              return `<span class="u-session-prompt">$</span> ${esc(line.text)}`;
            case 'out':
              return `<span class="u-session-out">${esc(line.text)}</span>`;
            case 'call':
              return `<span class="u-session-call">${esc(line.tool)}</span>  <span class="u-session-arg">${esc(line.arg)}</span>`;
            case 'gap':
              return '';
            default:
              return esc(line.text);
          }
        })
        .join('\n')
    : undefined;
---

<article class="u-app">
  <div class="u-app-well">
    {
      capture && (
        <>
          <img
            class="u-on-light"
            src={capture.light.src}
            width={capture.light.width}
            height={capture.light.height}
            alt=""
            loading="lazy"
            decoding="async"
          />
          <img
            class="u-on-dark"
            src={capture.dark.src}
            width={capture.dark.width}
            height={capture.dark.height}
            alt=""
            loading="lazy"
            decoding="async"
          />
        </>
      )
    }
    {session && <pre class="u-session" aria-hidden="true" set:html={session} />}
  </div>

  <div class="u-app-body">
    {/* The status sits at the end of the title's row while both fit, and wraps under
        the title, aligned with it, when they do not: a long name beside a long English
        status ran into it at 1440px. */}
    <div class="u-app-head">
      <AppIcon
        product={product.id}
        size={40}
        transitionName={morph ? `mark-${product.id}` : undefined}
      />
      <div class="u-app-headtext">
        <div class="u-app-title">
          <h3 class="u-app-name" style={morph ? `view-transition-name: title-${product.id}` : undefined}>
            <a href={href}>{product.name}</a>
          </h3>
          <p class="u-app-kind">{t(productKind(product))}</p>
        </div>
        <StatusTag lang={lang} state={product.status} />
      </div>
    </div>

    <p class="u-app-text">{product.tagline[lang]}</p>
    <p class="u-app-plat"><span class="sr-only">{t('platform.label')}: </span>{platforms}</p>

    <div class="u-app-foot">
      {
        product.version && (
          <p>
            <span class="sr-only">{t('product.version')} </span>
            <span class="u-app-ver">{product.version}</span>
            {product.released && (
              <>
                <span class="sr-only">, {t('product.released')} </span>
                <span class="u-app-date">{product.released}</span>
              </>
            )}
          </p>
        )
      }
      <span class="u-app-links">
        <a
          class="u-icon-btn"
          href={product.repo}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={t('card.repo', { name: product.name })}
          title={t('card.repo', { name: product.name })}
        >
          <SocialIcon id="github" size={16} />
        </a>
        <span class="u-icon-btn u-app-go" aria-hidden="true"><Icon name="arrowRight" size={16} /></span>
      </span>
    </div>
  </div>
</article>
