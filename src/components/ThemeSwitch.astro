---
import Icon from './Icon.astro';
import { useTranslations, type Lang } from '../i18n/ui';

/**
 * Theme control — three states, not two, in an icon menu whose icon shows the state the
 * page is in.
 *
 * `system` is a real option and the default: the site has always honoured
 * `prefers-color-scheme`, and a two-state toggle would strand every visitor who wants
 * exactly that. Choosing `system` *removes* the stored preference rather than storing a
 * third value, which is why the CSS override is keyed on `[data-theme="dark"]` /
 * `[data-theme="light"]` and absence means "ask the OS". The summary's icon is chosen by
 * the same attribute in CSS (`.u-ti`), so it is right from the first paint.
 *
 * Buttons with `aria-pressed` rather than a radio group: three buttons need no arrow-key
 * handling to be correct, where `role="radio"` would oblige us to reimplement roving
 * focus. Each button has its text label beside its icon.
 *
 * The control ships `display: none` and is revealed by `html[data-js]`, set by the
 * pre-paint script in Layout — the same rule the copy buttons follow: an affordance that
 * cannot work must not be drawn.
 */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const modes = [
  { value: 'system', label: t('theme.system'), icon: 'monitor' },
  { value: 'light', label: t('theme.light'), icon: 'sun' },
  { value: 'dark', label: t('theme.dark'), icon: 'moon' },
] as const;
---

<details data-popover class="u-theme" data-theme-switch>
  <summary class="u-icon-btn" aria-label={t('theme.label')} title={t('theme.label')}>
    <span class="u-ti u-ti-system"><Icon name="monitor" /></span>
    <span class="u-ti u-ti-light"><Icon name="sun" /></span>
    <span class="u-ti u-ti-dark"><Icon name="moon" /></span>
  </summary>
  <div class="u-pop u-pop-end" role="group" aria-label={t('theme.label')}>
    {
      modes.map((mode) => (
        <button
          type="button"
          class="u-pop-row"
          data-theme-set={mode.value}
          aria-pressed={mode.value === 'system' ? 'true' : 'false'}
        >
          <Icon name={mode.icon} size={16} />
          {mode.label}
          <Icon name="check" size={16} strokeWidth={2} class="u-pop-check" />
        </button>
      ))
    }
  </div>
</details>

{/*
  Wiring, inline and colocated with the markup on purpose. Placed immediately after the
  control so the parser runs it before the nav is painted: the served HTML marks `system`
  as pressed, and a reader who pinned dark would otherwise see the wrong row checked for
  a frame. The pre-paint script in Layout handles the *colours*; this handles the
  control's own state and the clicks.

  Reads and writes are wrapped in try/catch because `localStorage` throws outright in a
  partitioned or storage-blocked context, and a theme control must not take the page
  down with it.
*/}
<script is:inline>
  (function () {
    var menu = document.querySelector('[data-theme-switch]');
    if (!menu) return;

    var buttons = menu.querySelectorAll('[data-theme-set]');
    var root = document.documentElement;
    var KEY = 'firlab-theme';
    /* The page ground (`--paper-0`) — the same pair Layout emits, and byte-identical on
       purpose: browser chrome continues the colour at the viewport's own edge, so
       diverging here would repaint the chrome on click. */
    var GROUND = { light: '#fbfcfe', dark: '#101317' };

    function stored() {
      try {
        var value = localStorage.getItem(KEY);
        if (value === 'light' || value === 'dark') return value;
      } catch (error) {
        /* storage unavailable — fall through to the OS preference */
      }
      return 'system';
    }

    /* The two `theme-color` metas in the document are media-scoped, so a media-less one
       placed first wins over both. Removed again for `system`, which is what hands the
       decision back to those two. */
    function ground(mode) {
      var meta = document.head.querySelector('meta[name="theme-color"]:not([media])');
      if (mode === 'system') {
        if (meta) meta.remove();
        return;
      }
      if (!meta) {
        meta = document.createElement('meta');
        meta.setAttribute('name', 'theme-color');
        document.head.insertBefore(meta, document.head.firstChild);
      }
      meta.setAttribute('content', GROUND[mode]);
    }

    function apply(mode) {
      if (mode === 'system') root.removeAttribute('data-theme');
      else root.setAttribute('data-theme', mode);

      ground(mode);

      buttons.forEach(function (button) {
        button.setAttribute(
          'aria-pressed',
          button.getAttribute('data-theme-set') === mode ? 'true' : 'false',
        );
      });
    }

    apply(stored());

    buttons.forEach(function (button) {
      button.addEventListener('click', function () {
        var mode = button.getAttribute('data-theme-set');
        try {
          if (mode === 'system') localStorage.removeItem(KEY);
          else localStorage.setItem(KEY, mode);
        } catch (error) {
          /* the choice still applies for this document, it just will not persist */
        }
        apply(mode);
        /* Close the menu and hand focus back to its summary, so focus does not stay
           on a button that has just been hidden. */
        menu.open = false;
        var summary = menu.querySelector('summary');
        if (summary) summary.focus();
      });
    });
  })();
</script>
