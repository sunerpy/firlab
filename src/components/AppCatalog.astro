---
import AppCard from './AppCard.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { categories, products, type Category } from '../i18n/products';

/**
 * AppCatalog — every project, one card each, in a grid of one, two and then three
 * columns. A new project needs no layout work: it is one more card.
 *
 * The category filter is a row of underlined tabs made of radio inputs plus `:has()`,
 * with no script. The hiding rules are generated from the categories actually present,
 * so a new category gets its rule by existing in the data. Where `:has()` is unsupported
 * the rules are dropped whole and every card stays visible; the tabs are hidden in that
 * case too (`@supports selector(:has(*))`), because a control that does nothing must
 * not be drawn. With a single category there is nothing to filter, so no tabs are
 * rendered at all.
 */
interface Props {
  lang: Lang;
  title: string;
  words: string[];
}

const { lang, title, words } = Astro.props;
const t = useTranslations(lang);

const present = categories(products);
const showFilter = present.length > 1;
const count = (category?: Category) =>
  category ? products.filter((product) => product.category === category).length : products.length;

const rules = present
  .map(
    (category) =>
      `#projects:has(#filter-${category}:checked) [data-category]:not([data-category="${category}"]){display:none}`,
  )
  .join('');
---

<section id="projects" aria-labelledby="projects-title" class="u-section u-projects">
  <div class="u-shell">
    <div class="u-head">
      <h2 id="projects-title">{title}</h2>
      <p>
        {
          words.map((run, i) => (
            <>
              {i > 0 && lang === 'en' && ' '}
              <span class="u-run">{run}</span>
            </>
          ))
        }
      </p>
    </div>

    {
      showFilter && (
        <fieldset class="u-tabs">
          <legend class="sr-only">{t('filter.label')}</legend>
          <input type="radio" name="filter" id="filter-all" value="all" checked />
          <label class="u-tab" for="filter-all">
            {t('filter.all')}
            <b>{count()}</b>
          </label>
          {present.map((category) => (
            <>
              <input type="radio" name="filter" id={`filter-${category}`} value={category} />
              <label class="u-tab" for={`filter-${category}`}>
                {t(`filter.${category}`)}
                <b>{count(category)}</b>
              </label>
            </>
          ))}
        </fieldset>
      )
    }

    <ul class="u-cards">
      {
        products.map((product) => (
          <li data-category={product.category}>
            <AppCard lang={lang} product={product} />
          </li>
        ))
      }
    </ul>
  </div>

  {showFilter && <style is:inline set:html={`.u-tabs{display:none}@supports selector(:has(*)){.u-tabs{display:flex}${rules}}`} />}
</section>
