---
import { useTranslations, type Lang } from '../i18n/ui';
import type { Principle } from '../i18n/content';

/**
 * Principles — the commitments the three tools share.
 *
 * A different layout family from the product bands on purpose: a sticky section
 * heading in the left columns against a stacked, hanging-numeral list on the
 * right. Not three equal cards, and not another rail/main/meta band.
 *
 * Every claim maps to a shipped behaviour named elsewhere on the page, so this
 * section is a summary rather than a values statement.
 */
interface Props {
  lang: Lang;
  principles: Principle[];
}

const { lang, principles } = Astro.props;
const t = useTranslations(lang);
---

<section
  aria-labelledby="principles"
  class="border-rule u-reveal grid gap-y-10 border-t py-14 md:py-24 lg:grid-cols-12 lg:gap-x-8"
>
  <div class="lg:col-span-4">
    <h2 id="principles" class="u-display text-title-sm lg:sticky lg:top-32">
      {t('principles.title')}
    </h2>
  </div>

  <ol class="u-stagger min-w-0 lg:col-span-7 lg:col-start-6">
    {
      principles.map((principle, i) => (
        <li
          class={`grid grid-cols-[2.75rem_minmax(0,1fr)] gap-x-5 gap-y-2 ${
            i > 0 ? 'border-rule mt-9 border-t pt-9' : ''
          }`}
        >
          <span
            aria-hidden="true"
            class="u-display u-display-latin text-accent text-[1.75rem] tabular-nums"
          >
            {principle.index}
          </span>
          <div class="min-w-0">
            <h3 class="u-display text-ink text-[1.25rem]">{principle.term}</h3>
            <p class="text-ink-body mt-2.5">{principle.body}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>
