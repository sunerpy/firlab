---
import AppIcon from './AppIcon.astro';
import Icon from './Icon.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { latestReleases, productKind, releaseTagHref } from '../i18n/products';

/**
 * ReleaseList — the latest stable release of each project, newest first, as one ledger:
 * date, project, version, kind and a link to the release notes.
 *
 * Built from the same `versions.ts` constants the cards show, which the daily drift
 * check holds to each repository's latest stable release, so this list moves when a
 * project ships and needs no editing of its own. Each row links to that release's notes
 * on GitHub through a stretched link, so the whole row is the target; the tag name is
 * the version string, after the project's `tagPrefix` where it has one
 * (`releaseTagHref`). Below 768px the row keeps the project, its version and the date,
 * and the link shows as its arrow alone.
 *
 * Capped, because past a handful of rows it stops being "latest" and becomes an
 * archive, which GitHub already is.
 */
interface Props {
  lang: Lang;
  title: string;
  note: string;
  linkLabel: string;
  limit?: number;
}

const { lang, title, note, linkLabel, limit = 6 } = Astro.props;
const t = useTranslations(lang);

const rows = latestReleases().slice(0, limit);
---

<section id="releases" aria-labelledby="releases-title" class="u-section">
  <div class="u-shell">
    <div class="u-head">
      <h2 id="releases-title">{title}</h2>
      <p>{note}</p>
    </div>

    <ol class="u-ledger">
      {
        rows.map((product) => (
          <li class="u-ledger-row">
            <time class="u-ledger-date" datetime={product.released}>
              {product.released}
            </time>
            <span class="u-ledger-app">
              <AppIcon product={product.id} size={28} />
              {product.name}
            </span>
            <span class="u-ledger-ver">{product.version}</span>
            <span class="u-ledger-kind">{t(productKind(product))}</span>
            <a
              class="u-ledger-link"
              href={releaseTagHref(product)}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={t('release.notes', { name: product.name, version: product.version! })}
            >
              <span class="u-ledger-label">{linkLabel}</span>
              <Icon name="arrowUpRight" size={15} />
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>
