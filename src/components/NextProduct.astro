---
import AppIcon from './AppIcon.astro';
import { useWayfinding } from '../i18n/wayfinding';
import { useTranslations, type Lang } from '../i18n/ui';
import { products, productHref, type ProductId } from '../i18n/products';

/**
 * NextProduct — the pager that ends a product page with one obvious next move,
 * in catalog order. A `<nav>` outside `<main>`, so it reads as navigation rather
 * than one more section of the page.
 *
 * The sequence wraps, so the last product points back at the first rather than
 * dead-ending; when it wraps the label says so, because an unannounced jump
 * backwards would read as a bug.
 */
interface Props {
  lang: Lang;
  currentId: ProductId;
}

const { lang, currentId } = Astro.props;
const w = useWayfinding(lang);
const t = useTranslations(lang);

const at = products.findIndex((product) => product.id === currentId);
const nextIndex = at === -1 ? 0 : (at + 1) % products.length;
const next = products[nextIndex]!;
const wrapped = at !== -1 && nextIndex < at;
---

{
  next.id !== currentId && (
    <nav aria-label={w('pager.nav')} class="u-shell u-reveal mt-20 mb-16 md:mt-28 md:mb-24">
      <article class="u-card u-card-link u-arrow-host group flex items-center gap-5 p-5 sm:gap-6 sm:p-7">
        <AppIcon product={next.id} size={56} />

        <div class="min-w-0 flex-1">
          <p class="text-ink-mute text-[0.8125rem]">
            {w('pager.label')}
            {wrapped && (
              <>
                <span aria-hidden="true" class="mx-1.5">
                  ·
                </span>
                {w('pager.wrap')}
              </>
            )}
          </p>
          <p class="u-display u-display-latin text-title-sm mt-1">
            <a href={productHref(lang, next)} class="u-stretch group-hover:text-accent">
              {next.name}
            </a>
          </p>
          <p class="text-ink-body mt-1.5 text-sm">
            <span class="sr-only">{t(`category.${next.category}`)} — </span>
            {next.tagline[lang]}
          </p>
        </div>

        <span aria-hidden="true" class="u-arrow text-ink-mute group-hover:text-accent shrink-0 text-2xl leading-none">
          →
        </span>
      </article>
    </nav>
  )
}
