---
import Layout from '../layouts/Layout.astro';
import SiteHeader from './SiteHeader.astro';
import AppCatalog from './AppCatalog.astro';
import ReleaseList from './ReleaseList.astro';
import ContactSection from './ContactSection.astro';
import SiteFooter from './SiteFooter.astro';
import SocialIcon from './SocialIcon.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { getHomeContent, listJoin } from '../i18n/content';
import { latestReleases, products, productHref, PLATFORM_ORDER } from '../i18n/products';
import { PERSON_ID, FREE_OFFER } from '../i18n/schema';

/**
 * The home page: a short introduction, the project catalog, the latest releases, and
 * where to report problems or follow along. Assembled once and rendered per locale, so
 * the two languages stay structurally identical.
 *
 * The introduction's prose names no product and counts none. Its facts are generated —
 * the platforms are the union of what the catalog ships for, the latest release is the
 * newest in `versions.ts` — so the page is the same page with five projects or fifteen.
 */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const c = getHomeContent(lang);
const site = Astro.site!;

const platforms = listJoin(
  lang,
  PLATFORM_ORDER.filter((platform) => products.some((product) => product.platforms.includes(platform))).map(
    (platform) => t(`platform.${platform}`),
  ),
);
const newest = latestReleases()[0];

/** A lede of runs: English needs a space between them; Chinese sets none after 。 or ，. */
const gap = lang === 'en' ? ' ' : '';

// One SoftwareApplication node per product, inside an ItemList.
//
// `offers` is free-of-charge and rides on the same `version` gate as
// `softwareVersion`: that field is the site's one signal for "has a public
// release". There is no `aggregateRating` and no `review` on any of them — see
// `i18n/schema.ts` for why that is permanent and not an oversight.
//
// The nodes carry no `@id`, unlike their product-page counterparts: giving them
// the product IRI would put two `description`s on one IRI (the tagline here, the
// full lede there). An anonymous node inside the list says "this list contains a
// thing like this" without claiming to be the authoritative record of it.
const structuredData = [
  {
    '@type': 'ItemList',
    name: c.projectsTitle,
    itemListOrder: 'https://schema.org/ItemListUnordered',
    numberOfItems: products.length,
    itemListElement: products.map((product, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'SoftwareApplication',
        name: product.name,
        applicationCategory: 'DeveloperApplication',
        operatingSystem: product.platforms
          .filter((platform) => platform !== 'docker')
          .map((platform) => t(`platform.${platform}`))
          .join(', '),
        description: product.tagline[lang],
        author: { '@id': PERSON_ID },
        url: new URL(productHref(lang, product), site).href,
        ...(product.version
          ? { softwareVersion: product.version.replace(/^v/, ''), offers: FREE_OFFER }
          : {}),
      },
    })),
  },
];
---

<Layout
  lang={lang}
  title={c.title}
  description={c.description}
  ogImageAlt={c.ogAlt}
  structuredData={structuredData}
>
  <SiteHeader lang={lang} />

  <main id="main">
    <section class="u-hero">
      <div class="u-shell u-hero-grid">
        {/* Two lines, one heading: the brand at hero size, then what it offers. The
            accessible name reads as one sentence, "FirLab 开源软件…". */}
        <h1>
          <span class="u-hero-name">{c.heroTitle}</span>{' '}
          <span class="u-hero-line">
            {
              c.heroLine.map((run, i) => (
                <>
                  {i > 0 && gap}
                  <span class="u-run">{run}</span>
                </>
              ))
            }
          </span>
        </h1>

        <div class="u-hero-side">
          {/* Clauses are inline-blocks: one that fits the line stays whole, so the lede
              breaks between clauses rather than mid-word. A clause longer than the line
              still wraps inside its own box. */}
          <p>
            {
              c.heroLede.map((run, i) => (
                <>
                  {i > 0 && gap}
                  <span class="u-run">{run}</span>
                </>
              ))
            }
          </p>

          <div class="u-actions">
            <a class="u-btn u-btn-ink" href="https://github.com/sunerpy" target="_blank" rel="noopener noreferrer">
              <SocialIcon id="github" size={18} />
              {c.heroGithub}
            </a>
            <details data-popover>
              <summary class="u-btn u-btn-line">
                <SocialIcon id="wechat" size={18} />
                {c.heroFollow}
              </summary>
              <div class="u-pop u-qr">
                {/* White plate in both themes: a scanner needs a light ground. */}
                <img
                  src="/wechat-official-account.jpg"
                  width="430"
                  height="430"
                  alt={t('social.wechatOa.alt')}
                  decoding="async"
                />
                <p>{t('social.wechatOa.name')} · {t('social.wechatOa.caption')}</p>
              </div>
            </details>
          </div>

          <ul class="u-facts">
            <li>{c.factPlatforms.replace('{list}', platforms)}</li>
            {
              newest && (
                <li>
                  <span>
                    {c.factLatest}
                    <a class="u-link" href="#releases">
                      {newest.name} {newest.version}
                    </a>
                    {c.factLatestSep}
                    {newest.released}
                  </span>
                </li>
              )
            }
            <li>{c.factPrivacy}</li>
          </ul>
        </div>
      </div>
    </section>

    <AppCatalog lang={lang} title={c.projectsTitle} words={c.projectsWords} />

    <ReleaseList lang={lang} title={c.releasesTitle} note={c.releasesNote} linkLabel={c.releaseNotes} />

    <ContactSection lang={lang} content={c} />
  </main>

  <SiteFooter lang={lang} />
</Layout>
