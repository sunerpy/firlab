---
import Layout from '../layouts/Layout.astro';
import FloatingNav from './FloatingNav.astro';
import Hero from './Hero.astro';
import ProductEntry from './ProductEntry.astro';
import Principles from './Principles.astro';
import SiteFooter from './SiteFooter.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { getContent } from '../i18n/content';
import { PERSON_ID, FREE_OFFER } from '../i18n/schema';

/**
 * The home page, assembled once and rendered per locale. Keeping both languages
 * on one component is what guarantees they stay structurally identical — a
 * section added to Chinese cannot silently go missing from English.
 */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const content = getContent(lang);

// SoftwareApplication nodes, one per product.
//
// `offers` is free-of-charge and rides on the same `product.version` gate as
// `softwareVersion`, because that flag is the site's one signal for "has a public
// release". Voxera has none, so it carries no version, no `url` and no price: it
// is not offered yet, and `price: 0` would assert that it is. There is no
// `aggregateRating` and no `review` on any of them — see `i18n/schema.ts` for why
// that is permanent and not an oversight.
//
// These nodes are deliberately left WITHOUT an `@id`, unlike their detail-page
// counterparts. Giving them the product IRI would put two different
// `description` values on one IRI — the summary line here, the full lede there —
// which is precisely the contradiction the per-locale `@id` work removed. An
// anonymous node inside the list says "this list contains a thing like this"
// without claiming to be the authoritative record of it.
//
// No `programmingLanguage`: it is not a valid `SoftwareApplication` property.
// Worth noting that this loop used to hardcode `'Rust'` for all four products,
// so it was also reporting pt-tools — which is Go — incorrectly. Removing it
// fixes a validator warning and a factual error in the same edit.
const structuredData = [
  {
    '@type': 'ItemList',
    name: 'FirLab developer tools',
    itemListOrder: 'https://schema.org/ItemListOrderAscending',
    numberOfItems: content.products.length,
    itemListElement: content.products.map((product, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'SoftwareApplication',
        name: product.name,
        applicationCategory: 'DeveloperApplication',
        operatingSystem: 'Linux, macOS, Windows',
        description: product.body,
        author: { '@id': PERSON_ID },
        ...(product.version
          ? { softwareVersion: product.version.replace(/^v/, ''), offers: FREE_OFFER }
          : {}),
        ...(product.links?.[0] ? { url: product.links[0].href } : {}),
      },
    })),
  },
];
---

<Layout
  lang={lang}
  title={content.title}
  description={content.description}
  ogImageAlt={content.ogAlt}
  structuredData={structuredData}
>
  <FloatingNav lang={lang} products={content.products} />

  <main id="main" class="u-shell">
    <Hero lang={lang} content={content} />

    {/* Each entry owns its own top rule and top margin — see `.u-band*` and
        ProductEntry's four shapes. The section adds no spacing of its own,
        because the boundary between two entries is information (a rule opens a
        movement, space continues one) and a uniform gap here would flatten it
        back into the four-identical-bands run this pass exists to remove. */}
    <section aria-label={t('product.label')}>
      {content.products.map((product) => <ProductEntry lang={lang} product={product} />)}
    </section>

    <Principles lang={lang} principles={content.principles} />
  </main>

  <SiteFooter lang={lang} products={content.products} />
</Layout>
