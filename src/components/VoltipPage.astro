---
import Layout from '../layouts/Layout.astro';
import FloatingNav from './FloatingNav.astro';
import SiteFooter from './SiteFooter.astro';
import NextProduct from './NextProduct.astro';
import ProductMark from './ProductMark.astro';
import StatusTag from './StatusTag.astro';
import InstallBlock from './InstallBlock.astro';
import DetailSection from './DetailSection.astro';
import DefRows from './DefRows.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Lang } from '../i18n/ui';
import { getContent } from '../i18n/content';
import { getVoltipContent, getVoltipSections, VOLTIP_SITE } from '../i18n/voltip';
import { VOLTIP_RELEASED, VOLTIP_VERSION } from '../i18n/versions';
import { entityId, PERSON_ID, FREE_OFFER } from '../i18n/schema';

/**
 * The Voltip detail page, assembled once and rendered per locale — the same
 * single-source approach as the other detail pages, so a section added to Chinese
 * cannot silently go missing from English.
 *
 * Shorter than AgentLens's on purpose. Voltip has its own site with the full user
 * guide in both languages; this page states what the tool does, what leaves the
 * computer in each mode, how to install it and where it stands, and hands over to
 * that site for everything else. The work still in development gets the dashed
 * draft enclosure the index uses for unreleased work, so it cannot be read as a
 * shipped feature.
 */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const c = getVoltipContent(lang);

const site = getContent(lang);
const sections = getVoltipSections(c);

const homeHref = getRelativeLocaleUrl(lang, '');

// SoftwareApplication plus a breadcrumb, as on the other released products. `url`
// is the product's own site, the page a visitor should land on; the full
// reasoning for `offers` and the absent ratings lives in `i18n/schema.ts`.
const structuredData = [
  {
    '@type': 'SoftwareApplication',
    '@id': entityId(lang, 'voltip'),
    name: 'Voltip',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Windows, macOS, Linux',
    softwareVersion: VOLTIP_VERSION.replace(/^v/, ''),
    datePublished: VOLTIP_RELEASED,
    description: c.description,
    url: lang === 'en' ? VOLTIP_SITE : `${VOLTIP_SITE}/zh/`,
    offers: FREE_OFFER,
    author: { '@id': PERSON_ID },
    license: 'https://www.apache.org/licenses/LICENSE-2.0',
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'FirLab', item: 'https://firlab.app' },
      { '@type': 'ListItem', position: 2, name: 'Voltip' },
    ],
  },
];
---

<Layout
  lang={lang}
  title={c.title}
  description={c.description}
  ogImageAlt={c.ogAlt}
  structuredData={structuredData}
>
  <FloatingNav lang={lang} products={site.products} currentId="voltip" />

  <main id="main" class="u-shell">
    {/* ---- Masthead ------------------------------------------------------ */}
    <header class="u-enter grid gap-y-10 pt-14 pb-12 md:pt-20 md:pb-16 lg:grid-cols-12 lg:gap-x-10">
      <div class="min-w-0 lg:col-span-8">
        <p class="u-meta text-ink-mute">
          <a href={homeHref} class="text-ink-mute hover:text-accent no-underline">FirLab</a>
          <span aria-hidden="true" class="mx-2">/</span>
          <span class="u-lat tabular-nums">{c.eyebrow}</span>
        </p>

        <div class="mt-6 flex items-center gap-5">
          <span class="inline-flex shrink-0" style="view-transition-name: mark-voltip">
            <ProductMark product="voltip" size={56} class="text-ink-soft" />
          </span>
          <h1
            class="u-display u-display-latin text-display min-w-0"
            style="view-transition-name: title-voltip"
          >
            Voltip
          </h1>
        </div>

        <p class="text-ink-soft mt-5 font-mono text-sm">{c.role}</p>

        <p class="u-lede text-ink-soft mt-8">
          <span class="text-ink">{c.ledeAccent}</span> {c.lede}
        </p>
      </div>

      {/* Meta rail — maturity, version, links, and the page's own index. */}
      <div class="u-plate min-w-0 self-start lg:col-span-3 lg:col-start-10">
        <StatusTag lang={lang} state="early" display="block" />

        <dl class="divide-rule border-rule mt-5 divide-y border-t text-sm">
          <div class="flex items-baseline justify-between gap-4 py-2.5">
            <dt class="u-meta text-ink-mute shrink-0">{t('product.version')}</dt>
            <dd class="text-ink-soft font-mono tabular-nums">{VOLTIP_VERSION}</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 py-2.5">
            <dt class="u-meta text-ink-mute shrink-0">{t('product.released')}</dt>
            <dd class="text-ink-soft font-mono tabular-nums">{VOLTIP_RELEASED}</dd>
          </div>
        </dl>

        <ul class="border-rule flex flex-wrap gap-x-6 gap-y-2 border-t pt-4 text-sm">
          {
            c.links.items.map((link) => (
              <li>
                <a href={link.href} target="_blank" rel="noopener noreferrer">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>

        <nav aria-label={c.tocLabel} class="border-rule mt-6 border-t pt-5">
          <h2 class="u-meta text-ink-mute">{c.tocLabel}</h2>
          <ol class="mt-3 -mx-1.5">
            {
              sections.map((section) => (
                <li>
                  <a
                    href={`#${section.id}`}
                    class="u-row text-ink-mute hover:text-accent flex gap-3 rounded-[var(--radius-chip)] px-1.5 py-1.5 text-sm no-underline"
                  >
                    <span class="u-meta text-ink-mute pt-px tabular-nums">{section.num}</span>
                    <span class="min-w-0">{section.label}</span>
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>
      </div>
    </header>

    {/* ---- 01 Purpose ---------------------------------------------------- */}
    <DetailSection section={c.purpose} rhythm="open">
      <div class="mt-6 space-y-5">
        {c.purpose.paras.map((para) => <p class="u-measure">{para}</p>)}
      </div>

      <h3 class="u-meta text-ink-mute border-rule mt-10 border-t pt-8">{c.purpose.whoLabel}</h3>
      <dl class="u-stagger mt-5 space-y-5">
        {
          c.purpose.who.map((item) => (
            <div>
              <dt class="text-ink-soft font-mono text-sm">{item.term}</dt>
              <dd class="mt-1.5 u-measure text-sm">{item.body}</dd>
            </div>
          ))
        }
      </dl>
    </DetailSection>

    {/* ---- 02 Capabilities ---------------------------------------------- */}
    <DetailSection section={c.capabilities} layout="wide" rhythm="next">
      <dl class="u-stagger border-rule mt-8 grid gap-x-10 gap-y-7 border-t pt-8 xl:grid-cols-2">
        {
          c.capabilities.groups.map((group) => (
            <div class="min-w-0">
              <dt class="u-meta text-accent">{group.term}</dt>
              <dd class="mt-2 text-sm">{group.body}</dd>
            </div>
          ))
        }
      </dl>
    </DetailSection>

    {/* ---- 03 Data -------------------------------------------------------
        One axis: what is sent, and where. Said in words, never by colour. */}
    <DetailSection section={c.privacy} rhythm="open">
      <p class="text-ink-body mt-6 u-measure">{c.privacy.intro}</p>

      <ul class="divide-rule u-stagger border-rule mt-8 divide-y border-y">
        {
          c.privacy.modes.map((mode) => (
            <li class="grid gap-x-8 gap-y-2 py-6 sm:grid-cols-[12rem_minmax(0,1fr)]">
              <div class="min-w-0">
                <h3 class="text-ink text-[0.9375rem] font-medium">{mode.name}</h3>
                <p class="u-meta text-ink-mute mt-2">{c.privacy.sendsLabel}</p>
                <p class="text-ink-soft mt-1 font-mono text-sm">{mode.sends}</p>
              </div>
              <p class="text-ink-body min-w-0 text-sm sm:pt-0.5">{mode.detail}</p>
            </li>
          ))
        }
      </ul>
    </DetailSection>

    {/* ---- 04 Install ---------------------------------------------------- */}
    <DetailSection section={c.install} rhythm="next">
      <p class="text-ink-body mt-6 u-measure">{c.install.intro}</p>

      <h3 class="u-meta text-ink-mute mt-9">{c.install.packagesLabel}</h3>
      <dl class="border-rule u-stagger mt-4 divide-rule divide-y border-y">
        {
          c.install.packages.map((pkg) => (
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-3">
              <dt class="text-ink-soft font-mono text-sm">{pkg.platform}</dt>
              <dd class="text-ink-mute font-mono text-sm">{pkg.artifact}</dd>
            </div>
          ))
        }
      </dl>

      <InstallBlock lang={lang} label={c.install.commandsLabel} lines={c.install.lines} />

      <h3 class="u-meta text-ink-mute mt-9">{c.install.afterLabel}</h3>
      <p class="mt-3 u-measure text-sm">{c.install.after}</p>
    </DetailSection>

    {/* ---- 05 Platforms -------------------------------------------------- */}
    <DetailSection section={c.platforms} layout="wide" rhythm="tight">
      <DefRows items={c.platforms.rows} class="border-rule mt-8 border-t" />
    </DetailSection>

    {/* ---- 06 Status ----------------------------------------------------- */}
    <DetailSection section={c.maturity} rhythm="open">
      <div class="mt-6 space-y-5">
        {c.maturity.paras.map((para) => <p class="u-measure">{para}</p>)}
      </div>

      <h3 class="u-meta text-ink-mute mt-10">{c.maturity.buildingLabel}</h3>
      {/* Unreleased work in the dashed draft enclosure, as on the index. */}
      <dl class="u-stagger mt-4 space-y-4">
        {
          c.maturity.building.map((item) => (
            <div class="u-plate-draft">
              <dt class="text-ink-soft font-mono text-sm">{item.term}</dt>
              <dd class="mt-1.5 u-measure text-sm">{item.body}</dd>
            </div>
          ))
        }
      </dl>
    </DetailSection>

    {/* ---- 07 Links ------------------------------------------------------ */}
    <DetailSection section={c.links} rhythm="next">
      <ul class="mt-6 space-y-3">
        {
          c.links.items.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noopener noreferrer" class="font-mono text-sm">
                {link.href.replace('https://', '')}
              </a>
            </li>
          ))
        }
      </ul>

      <p class="border-rule mt-10 border-t pt-8">
        <a href={homeHref} class="text-sm">{c.backToIndex}</a>
      </p>
    </DetailSection>
  </main>

  <NextProduct lang={lang} products={site.products} currentId="voltip" />

  <SiteFooter lang={lang} products={site.products} variant="detail" currentId="voltip" />
</Layout>
