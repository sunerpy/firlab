---
import Layout from '../layouts/Layout.astro';
import SiteHeader from './SiteHeader.astro';
import ProductHeader from './ProductHeader.astro';
import SiteFooter from './SiteFooter.astro';
import NextProduct from './NextProduct.astro';
import InstallBlock from './InstallBlock.astro';
import DetailSection from './DetailSection.astro';
import DefRows from './DefRows.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { type Lang } from '../i18n/ui';
import { getHomeContent } from '../i18n/content';
import { getVoltipContent, getVoltipSections } from '../i18n/voltip';
import { getProduct } from '../i18n/products';
import { entityId, PERSON_ID, FREE_OFFER } from '../i18n/schema';

/**
 * The Voltip detail page, assembled once and rendered per locale — the same
 * single-source approach as the other detail pages, so a section added to Chinese
 * cannot silently go missing from English.
 *
 * Shorter than AgentLens's on purpose. Voltip has its own site with the full user
 * guide in both languages; this page states what the tool does, what leaves the
 * computer in each mode, how to install it and where it stands, and hands over to
 * that site for everything else. The work still in development gets the dashed
 * draft enclosure used for unreleased work, so it cannot be read as a shipped
 * feature.
 */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = getVoltipContent(lang);
const product = getProduct('voltip');
const sections = getVoltipSections(c);

const homeHref = getRelativeLocaleUrl(lang, '');

// SoftwareApplication plus a breadcrumb, as on the other released products. `url`
// is the product's own site, the page a visitor should land on; the full
// reasoning for `offers` and the absent ratings lives in `i18n/schema.ts`.
const structuredData = [
  {
    '@type': 'SoftwareApplication',
    '@id': entityId(lang, 'voltip'),
    name: 'Voltip',
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Windows, macOS, Linux',
    softwareVersion: product.version!.replace(/^v/, ''),
    datePublished: product.released,
    description: c.description,
    url: product.site![lang],
    offers: FREE_OFFER,
    author: { '@id': PERSON_ID },
    license: 'https://www.gnu.org/licenses/agpl-3.0.html',
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'FirLab', item: 'https://firlab.app' },
      { '@type': 'ListItem', position: 2, name: 'Voltip' },
    ],
  },
];
---

<Layout
  lang={lang}
  title={c.title}
  description={c.description}
  ogImageAlt={getHomeContent(lang).ogAlt}
  structuredData={structuredData}
>
  <SiteHeader lang={lang} currentId="voltip" />

  <main id="main" class="u-shell">
    <ProductHeader
      lang={lang}
      product={product}
      role={c.role}
      ledeAccent={c.ledeAccent}
      lede={c.lede}
      toc={sections}
      tocLabel={c.tocLabel}
      installId={c.install.id}
    />

    {/* ---- 01 Purpose ---------------------------------------------------- */}
    <DetailSection section={c.purpose} rhythm="open">
      <div class="mt-6 space-y-5">
        {c.purpose.paras.map((para) => <p class="u-measure">{para}</p>)}
      </div>

      <h3 class="u-meta text-ink-mute border-rule mt-10 border-t pt-8">{c.purpose.whoLabel}</h3>
      <dl class="u-stagger mt-5 space-y-5">
        {
          c.purpose.who.map((item) => (
            <div>
              <dt class="text-ink-soft font-mono text-sm">{item.term}</dt>
              <dd class="mt-1.5 u-measure text-sm">{item.body}</dd>
            </div>
          ))
        }
      </dl>
    </DetailSection>

    {/* ---- 02 Capabilities ---------------------------------------------- */}
    <DetailSection section={c.capabilities} layout="wide" rhythm="next">
      <dl class="u-stagger border-rule mt-8 grid gap-x-10 gap-y-7 border-t pt-8 xl:grid-cols-2">
        {
          c.capabilities.groups.map((group) => (
            <div class="min-w-0">
              <dt class="u-meta text-accent">{group.term}</dt>
              <dd class="mt-2 text-sm">{group.body}</dd>
            </div>
          ))
        }
      </dl>
    </DetailSection>

    {/* ---- 03 Data -------------------------------------------------------
        One axis: what is sent, and where. Said in words, never by colour. */}
    <DetailSection section={c.privacy} rhythm="open">
      <p class="text-ink-body mt-6 u-measure">{c.privacy.intro}</p>

      <ul class="divide-rule u-stagger border-rule mt-8 divide-y border-y">
        {
          c.privacy.modes.map((mode) => (
            <li class="grid gap-x-8 gap-y-2 py-6 sm:grid-cols-[12rem_minmax(0,1fr)]">
              <div class="min-w-0">
                <h3 class="text-ink text-[0.9375rem] font-medium">{mode.name}</h3>
                <p class="u-meta text-ink-mute mt-2">{c.privacy.sendsLabel}</p>
                <p class="text-ink-soft mt-1 font-mono text-sm">{mode.sends}</p>
              </div>
              <p class="text-ink-body min-w-0 text-sm sm:pt-0.5">{mode.detail}</p>
            </li>
          ))
        }
      </ul>
    </DetailSection>

    {/* ---- 04 Install ---------------------------------------------------- */}
    <DetailSection section={c.install} rhythm="next">
      <p class="text-ink-body mt-6 u-measure">{c.install.intro}</p>

      <h3 class="u-meta text-ink-mute mt-9">{c.install.packagesLabel}</h3>
      <dl class="border-rule u-stagger mt-4 divide-rule divide-y border-y">
        {
          c.install.packages.map((pkg) => (
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-3">
              <dt class="text-ink-soft font-mono text-sm">{pkg.platform}</dt>
              <dd class="text-ink-mute font-mono text-sm">{pkg.artifact}</dd>
            </div>
          ))
        }
      </dl>

      <InstallBlock lang={lang} label={c.install.commandsLabel} lines={c.install.lines} />

      <h3 class="u-meta text-ink-mute mt-9">{c.install.afterLabel}</h3>
      <p class="mt-3 u-measure text-sm">{c.install.after}</p>
    </DetailSection>

    {/* ---- 05 Platforms -------------------------------------------------- */}
    <DetailSection section={c.platforms} layout="wide" rhythm="tight">
      <DefRows items={c.platforms.rows} class="border-rule mt-8 border-t" />
    </DetailSection>

    {/* ---- 06 Status ----------------------------------------------------- */}
    <DetailSection section={c.maturity} rhythm="open">
      <div class="mt-6 space-y-5">
        {c.maturity.paras.map((para) => <p class="u-measure">{para}</p>)}
      </div>

      <h3 class="u-meta text-ink-mute mt-10">{c.maturity.buildingLabel}</h3>
      {/* Unreleased work in the dashed draft enclosure. */}
      <dl class="u-stagger mt-4 space-y-4">
        {
          c.maturity.building.map((item) => (
            <div class="u-card-draft p-5 sm:p-6">
              <dt class="text-ink-soft font-mono text-sm">{item.term}</dt>
              <dd class="mt-1.5 u-measure text-sm">{item.body}</dd>
            </div>
          ))
        }
      </dl>
    </DetailSection>

    {/* ---- 07 Links ------------------------------------------------------ */}
    <DetailSection section={c.links} rhythm="next">
      <ul class="mt-6 space-y-3">
        {
          c.links.items.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="font-mono text-sm [overflow-wrap:anywhere]"
              >
                {link.href.replace('https://', '')}
              </a>
            </li>
          ))
        }
      </ul>

      <p class="border-rule mt-10 border-t pt-8">
        <a href={homeHref} class="text-sm">{c.backToIndex}</a>
      </p>
    </DetailSection>
  </main>

  <NextProduct lang={lang} currentId="voltip" />

  <SiteFooter lang={lang} currentId="voltip" />
</Layout>
