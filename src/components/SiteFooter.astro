---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Wordmark from './Wordmark.astro';
import AppIcon from './AppIcon.astro';
import SocialRow from './SocialRow.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { products, productHref, type ProductId } from '../i18n/products';

/**
 * SiteFooter — identity, the app list, and every contact with its text label.
 *
 * One shape on every page. The app list comes from the catalog, so a new product
 * appears here without an edit; on a product page that product is marked
 * `aria-current="page"` and is not a link to itself. The labelled social row is
 * also the accessible-name redundancy for the header's icon-only GitHub link.
 *
 * The QR panels open upward here because the footer sits at the document's end.
 */
interface Props {
  lang: Lang;
  currentId?: ProductId;
}

const { lang, currentId } = Astro.props;
const t = useTranslations(lang);

const year = new Date().getFullYear();
const home = getRelativeLocaleUrl(lang, '');
---

<footer class="border-rule bg-panel border-t">
  {/* Three columns only from `lg`: at 768px a 3-of-12 column is ~146px and
      "WeChat Official Account" wrapped inside its link. Between `sm` and `lg` the
      identity spans the top and the two lists sit side by side. */}
  <div class="u-shell grid gap-x-10 gap-y-10 py-12 sm:grid-cols-2 md:py-16 lg:grid-cols-12">
    <div class="sm:col-span-2 lg:col-span-5">
      <a
        href={home}
        class="text-ink hover:text-ink inline-flex min-h-8 items-center no-underline"
        aria-label={t('nav.home')}
      >
        <Wordmark />
      </a>
      <p class="text-ink-mute mt-4 max-w-[30rem] text-sm">{t('footer.blurb')}</p>
    </div>

    <nav aria-label={t('footer.nav')} class="lg:col-span-3">
      <h2 class="u-label">{t('nav.apps')}</h2>
      <ul class="mt-4 space-y-1">
        {
          products.map((product) => (
            <li>
              {product.id === currentId ? (
                <span aria-current="page" class="text-ink inline-flex items-center gap-2.5 py-1 text-sm font-semibold">
                  <AppIcon product={product.id} size={20} />
                  {product.name}
                  <span class="sr-only">— {t('nav.current')}</span>
                </span>
              ) : (
                <a
                  href={productHref(lang, product)}
                  class="text-ink-body hover:text-accent inline-flex items-center gap-2.5 py-1 text-sm no-underline"
                >
                  <AppIcon product={product.id} size={20} />
                  {product.name}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="lg:col-span-3 lg:col-start-10">
      <h2 class="u-label">{t('social.label')}</h2>
      <SocialRow lang={lang} placement="above" class="mt-4" />
    </div>

    <div class="border-rule border-t pt-6 sm:col-span-2 lg:col-span-12">
      <p class="text-ink-mute text-xs">
        <span class="u-lat">{t('footer.copyright', { year })}</span>
        <span aria-hidden="true" class="mx-1.5">·</span>
        {t('footer.privacy')}
      </p>
    </div>
  </div>
</footer>
