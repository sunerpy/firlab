---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Wordmark from './Wordmark.astro';
import { useTranslations, stripLocale, htmlLang, type Lang } from '../i18n/ui';
import { categories, products, productHref, type ProductId } from '../i18n/products';

/**
 * SiteFooter — identity with the Official Account's QR code, then every project in a
 * column per category and the profiles with their text labels, then the line that says
 * what the site does not collect.
 *
 * One shape on every page. The project columns come from the catalog, so a new project
 * appears here without an edit; on a product page that project is marked
 * `aria-current="page"` and is not a link to itself. The labelled profile links are also
 * the accessible-name redundancy for the header's icon-only controls.
 */
interface Props {
  lang: Lang;
  currentId?: ProductId;
}

const { lang, currentId } = Astro.props;
const t = useTranslations(lang);

const year = new Date().getFullYear();
const home = getRelativeLocaleUrl(lang, '');
const slug = stripLocale(Astro.url.pathname);

const groups = categories(products).map((category) => ({
  category,
  items: products.filter((product) => product.category === category),
}));

const profiles = [
  { href: 'https://github.com/sunerpy', label: t('social.github') },
  { href: 'https://space.bilibili.com/35507467', label: t('social.bilibili') },
  { href: 'https://www.zhihu.com/people/bluer-ain', label: t('social.zhihu') },
  { href: 'https://x.com/sunerpy', label: t('social.x') },
];

const languages: { code: Lang; name: string }[] = [
  { code: 'zh-cn', name: t('lang.zh') },
  { code: 'en', name: t('lang.en') },
];
---

<footer class="u-foot">
  <div class="u-shell">
    <div class="u-foot-grid">
      <div class="u-foot-brand">
        <a href={home} class="u-brand" aria-label={t('nav.home')}>
          <Wordmark />
        </a>
        <p>{t('footer.blurb')}</p>
        <div class="u-foot-qr">
          {/* White plate in both themes: a scanner needs a light ground. */}
          <img
            src="/wechat-official-account.jpg"
            width="430"
            height="430"
            alt={t('social.wechatOa.alt')}
            loading="lazy"
            decoding="async"
          />
          <span>
            {t('social.wechatOa.name')}
            <span>{t('social.wechatOa.caption')}</span>
          </span>
        </div>
      </div>

      <nav class="u-foot-nav" aria-label={t('footer.nav')}>
        {
          groups.map((group) => (
            <div class="u-foot-col">
              <h2 id={`foot-${group.category}`}>{t(`filter.${group.category}`)}</h2>
              <ul aria-labelledby={`foot-${group.category}`}>
                {group.items.map((product) => (
                  <li>
                    {product.id === currentId ? (
                      <span aria-current="page">
                        {product.name}
                        <span class="sr-only"> — {t('nav.current')}</span>
                      </span>
                    ) : (
                      <a href={productHref(lang, product)}>{product.name}</a>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
        <div class="u-foot-col">
          <h2 id="foot-profiles">{t('social.label')}</h2>
          <ul aria-labelledby="foot-profiles">
            {
              profiles.map((profile) => (
                <li>
                  <a href={profile.href} target="_blank" rel="noopener noreferrer">
                    {profile.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </nav>
    </div>

    <div class="u-foot-bottom">
      <p>{t('footer.copyright', { year })} · {t('footer.privacy')}</p>
      <p>
        {
          languages.map((language, i) => (
            <>
              {i > 0 && ' · '}
              {language.code === lang ? (
                <span aria-current="true" lang={htmlLang[language.code]}>
                  {language.name}
                </span>
              ) : (
                <a
                  href={getRelativeLocaleUrl(language.code, slug)}
                  hreflang={htmlLang[language.code]}
                  lang={htmlLang[language.code]}
                >
                  {language.name}
                </a>
              )}
            </>
          ))
        }
      </p>
    </div>
  </div>
</footer>
