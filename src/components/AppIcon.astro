---
import type { ProductId } from '../i18n/products';

/**
 * AppIcon — each product's app icon, drawn inline: one SVG on the shipped icons'
 * 100-unit grid, navy tile included, so the site makes no image request for it and
 * the icon is crisp at every size.
 *
 * The geometry and colours are lifted from the shipped icons, so the card on this
 * site and the icon in the reader's dock are the same picture:
 *   pt-tools   brand/pt-tools/logo.svg (1024 grid, scaled to 100)
 *   AgentLens  AgentLens src-tauri/icons/source/icon.svg — a plateless hexagon,
 *              set on the tile at 72% so it sits like the others
 *   Voltip     voltip packages/ui/src/components/Logo.tsx: 「声波光标」, three white sound bars
 *              running into a cyan text cursor, the cursor's gradient flattened to its cyan
 *   Lockra     lockra apps/desktop/src-tauri/icons/icon.svg: a blue padlock under a pale
 *              shackle, its body showing a masked code (three dots)
 *   CodeGraph  codegraph-rust ui/src/components/BrandMark.svelte (36 grid, scaled to 100):
 *              its two linked nodes, on the navy tile instead of the viewer's violet
 *              gradient, the same drawing as the documentation site's logo
 *   kiro-provider  kiro-provider docs/site/public/kiro-provider-logo.svg: a four-point spark
 *              (the model) inside a ring with three connection points (the clients it
 *              serves); it has no app icon, so the documentation site's logo is the mark
 *   bedrock-gateway  bedrock-gateway-rust docs/site/public/bedrock-gateway-logo.svg: two lanes
 *              (the OpenAI APIs a client speaks) merge and pass between two gateposts, and
 *              the lane past the gate is teal (Amazon Bedrock); no app icon either, so the
 *              documentation site's logo is the mark
 *   winer      winer app/src-tauri/app-icon.svg (512 grid, scaled to 100): the gold hexagon
 *              badge with its W cut through to the tile, the gradient flattened to the
 *              tray glyph's gold so a page with many icons repeats no gradient id
 *
 * The tile does not follow the theme — an app icon is the same object on a light
 * page and a dark one. Only its rim (`--tile-edge`) does, so a navy tile keeps its
 * silhouette on the near-black dark page.
 *
 * Decorative by default: every use sits next to the product's name, and a second
 * announcement of that name helps nobody. Pass `label` where the icon stands alone.
 */
interface Props {
  product: ProductId;
  /** Rendered size in px. */
  size?: number;
  label?: string;
  class?: string;
  /** `view-transition-name`, so a card's icon can morph into a product page header. */
  transitionName?: string;
}

const { product, size = 48, label, class: className = '', transitionName } = Astro.props;

const NAVY = '#0B1220';
const PALE = '#E7EDF5';
const ORANGE = '#F97316';
const WHITE = '#FFFFFF';
const CYAN = '#22D3EE';
const BLUE = '#339CFF';
const TEAL = '#14B8A6';
const SLATE = '#64748B';
const GOLD = '#E3BD66';
---

<svg
  width={size}
  height={size}
  viewBox="0 0 100 100"
  fill="none"
  class={`shrink-0 ${className}`}
  style={transitionName ? `view-transition-name: ${transitionName}` : undefined}
  {...(label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' })}
>
  <rect width="100" height="100" rx="22" fill={NAVY}></rect>
  <rect
    x="0.5"
    y="0.5"
    width="99"
    height="99"
    rx="21.5"
    stroke="var(--tile-edge)"
    stroke-width="1"
  ></rect>

  {
    product === 'pttools' && (
      <>
        <path
          d="M18.75 31.25 L37.5 50 L18.75 68.75"
          stroke={TEAL}
          stroke-width="12.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <rect x="56.25" y="37.5" width="31.25" height="25" fill={ORANGE} />
      </>
    )
  }

  {
    product === 'codegraph' && (
      <g transform="scale(2.7778)">
        <rect
          x="10.75"
          y="10.75"
          width="5.5"
          height="5.5"
          rx="1.4"
          stroke={PALE}
          stroke-width="1.5"
        />
        <path
          d="M16.25 13.5 C 21 13.5 22.5 15 22.5 19"
          stroke={PALE}
          stroke-width="1.5"
          stroke-linecap="round"
        />
        <rect x="19" y="19" width="7" height="7" rx="1.8" fill={ORANGE} />
      </g>
    )
  }

  {
    product === 'kiroprovider' && (
      <>
        <circle cx="50" cy="50" r="31" stroke={PALE} stroke-width="5" />
        <circle cx="50" cy="19" r="7" fill={PALE} />
        <circle cx="76.85" cy="65.5" r="7" fill={PALE} />
        <circle cx="23.15" cy="65.5" r="7" fill={PALE} />
        <path
          d="M50 32 Q52.4 47.6 68 50 Q52.4 52.4 50 68 Q47.6 52.4 32 50 Q47.6 47.6 50 32 Z"
          fill={TEAL}
        />
      </>
    )
  }

  {
    product === 'bedrockgateway' && (
      <>
        <path
          d="M18 31 H30 C42 31 42 50 54 50 M18 69 H30 C42 69 42 50 54 50"
          stroke={PALE}
          stroke-width="8"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path d="M50 46 H62 V54 H50 Z" fill={PALE} />
        <path d="M62 46 H82 A4 4 0 0 1 82 54 H62 Z" fill={TEAL} />
        <path d="M62 24 V38 M62 62 V76" stroke={PALE} stroke-width="8" stroke-linecap="round" />
      </>
    )
  }

  {
    product === 'agentlens' && (
      <g transform="translate(50 50) scale(0.072) translate(-512 -512)">
        <path d="M 512 34.816 L 98.747 273.408 L 98.747 750.592 L 512 989.184 Z" fill={PALE} />
        <path d="M 512 34.816 L 925.253 273.408 L 925.253 512 L 512 512 Z" fill={ORANGE} />
        <path d="M 512 512 L 925.253 512 L 925.253 750.592 L 512 989.184 Z" fill={TEAL} />
        <path
          d="M 512 34.816 L 512 989.184 M 512 512 L 925.253 512 M 512 34.816 L 925.253 273.408 L 925.253 750.592 L 512 989.184 L 98.747 750.592 L 98.747 273.408 Z"
          stroke={SLATE}
          stroke-width="28.672"
          stroke-linejoin="round"
          stroke-linecap="round"
        />
      </g>
    )
  }

  {
    product === 'voltip' && (
      <>
        <rect x="23.83" y="39.26" width="8.2" height="21.48" rx="4.1" fill={WHITE} />
        <rect x="36.72" y="29.49" width="8.2" height="41.02" rx="4.1" fill={WHITE} />
        <rect x="49.61" y="35.35" width="8.2" height="29.3" rx="4.1" fill={WHITE} />
        <rect x="69.14" y="22.66" width="7.03" height="54.69" rx="3.52" fill={CYAN} />
      </>
    )
  }

  {
    product === 'lockra' && (
      <>
        <path
          d="M37 45 V36 A13 13 0 0 1 63 36 V45"
          stroke={PALE}
          stroke-width="7"
          stroke-linecap="round"
        />
        <rect x="26" y="43" width="48" height="37" rx="9" fill={BLUE} />
        <circle cx="38" cy="61.5" r="4.2" fill={PALE} />
        <circle cx="50" cy="61.5" r="4.2" fill={PALE} />
        <circle cx="62" cy="61.5" r="4.2" fill={PALE} />
      </>
    )
  }

  {
    product === 'winer' && (
      <g transform="scale(0.1953125)">
        <path d="M256 74 L413.6 165 L413.6 347 L256 438 L98.4 347 L98.4 165 Z" fill={GOLD} />
        <path
          d="M256 88 L401.5 172 L401.5 340 L256 424 L110.5 340 L110.5 172 Z"
          stroke="#FFF3C4"
          stroke-opacity="0.35"
          stroke-width="6"
        />
        <path
          d="M148.2 215.3 L203.9 382.5 L256 296.4 L308.1 382.5 L363.8 215.3 L320.2 200.7 L295.9 273.5 L256 207.6 L216.1 273.5 L191.8 200.7 Z"
          fill={NAVY}
        />
      </g>
    )
  }
</svg>
