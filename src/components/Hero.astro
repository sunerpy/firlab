---
import { getRelativeLocaleUrl } from 'astro:i18n';
import StatusTag from './StatusTag.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import type { PageContent } from '../i18n/content';

/**
 * Hero — left-biased headline (never centred) with the product index in the
 * right columns, so the page announces itself as an index inside the first
 * viewport.
 *
 * The index rows are links to the product *pages*, not in-page anchors. As
 * anchors they scrolled the reader into a band and left them to scroll through
 * the other three; a table of contents on a site that has real pages should
 * lead to those pages. The trailing arrow is the site's existing "this is a
 * destination" mark, borrowed from the footer's way back and the pager.
 *
 * Exactly three text elements: eyebrow, headline, lede. No trust strip, no
 * tagline under the fold line, no CTA pair — the ledger *is* the call to
 * action, and it is specific.
 *
 * No reveal animation here: this block is above the fold on load, where a
 * scroll-triggered fade would read as a flash of missing content.
 */
interface Props {
  lang: Lang;
  content: PageContent;
}

const { lang, content } = Astro.props;
const t = useTranslations(lang);
---

<section class="grid gap-y-12 pt-16 pb-16 md:pt-24 md:pb-24 lg:grid-cols-12 lg:gap-x-8">
  <div class="min-w-0 lg:col-span-7">
    <p class="u-meta text-ink-mute mb-7">{t('hero.eyebrow')}</p>

    <h1 class="u-display text-display">{content.heroHeadline}</h1>

    <p class="u-lede text-ink-body mt-9 max-w-[42rem]">
      <span class="text-ink-soft">{content.heroLedeAccent}</span>{' '}
      {content.heroLede}
    </p>
  </div>

  <nav aria-label={t('hero.indexLabel')} class="min-w-0 lg:col-span-4 lg:col-start-9">
    <h2 class="u-meta text-ink-mute border-rule border-b pb-3">{t('hero.indexTitle')}</h2>
    <ul>
      {
        content.products.map((product) => (
          <li class="border-rule border-b">
            <a
              href={getRelativeLocaleUrl(lang, product.detail)}
              class="text-ink hover:text-accent group u-arrow-host flex items-baseline gap-4 py-4 no-underline"
            >
              <span class="u-meta text-ink-mute tabular-nums">{product.index}</span>
              <span class="min-w-0 flex-1">
                <span class="text-ink u-display-latin block font-mono text-[0.9375rem] group-hover:underline group-hover:underline-offset-4">
                  {product.name}
                </span>
                <StatusTag lang={lang} state={product.status} display="block" class="mt-1.5" />
              </span>
              <span class="text-ink-mute shrink-0 font-mono text-sm tabular-nums">
                {product.version ?? '—'}
              </span>
              <span aria-hidden="true" class="u-arrow text-ink-mute shrink-0 text-sm">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</section>
