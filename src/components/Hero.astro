---
import StatusTag from './StatusTag.astro';

/**
 * Hero — left-biased headline (never centred) with a compact mono ledger in the
 * right columns. The ledger makes the page announce itself as an index inside
 * the first viewport, and doubles as the only in-page navigation.
 */
export interface LedgerRow {
  index: string;
  id: string;
  name: string;
  version: string;
  status: 'live' | 'early' | 'wip';
}

interface Props {
  rows: LedgerRow[];
}

const { rows } = Astro.props;
---

<section class="grid gap-y-12 pt-14 pb-14 md:grid-cols-12 md:gap-x-8 md:pt-20 md:pb-20">
  <div class="md:col-span-7">
    <p class="u-meta text-ink-mute mb-6">Developer tools · built by one person</p>

    <h1 class="u-display text-display">
      Local-first tools for reading code, watching agents, and talking to both.
    </h1>

    <p class="text-lede text-ink-body mt-8 max-w-[40rem]">
      FirLab is where <span class="text-ink-soft">Shaonan Zhang</span> builds developer
      tools. Three of them so far: a deterministic code index, a usage archive for
      coding agents, and voice input aimed at editors and terminals. All written in
      Rust, all keeping their data on the machine you run them on.
    </p>
  </div>

  <nav aria-label="Products" class="md:col-span-4 md:col-start-9">
    <h2 class="u-meta text-ink-mute border-rule border-b pb-3">Index</h2>
    <ul>
      {
        rows.map((row) => (
          <li class="border-rule border-b">
            <a
              href={`#${row.id}`}
              class="text-ink hover:text-accent group flex items-baseline gap-4 py-4 no-underline"
            >
              <span class="u-meta text-ink-mute tabular-nums">{row.index}</span>
              <span class="flex-1">
                <span
                  class="text-ink block font-mono text-[0.9375rem] group-hover:underline group-hover:underline-offset-4"
                >
                  {row.name}
                </span>
                <StatusTag state={row.status} display="block" class="mt-1.5" />
              </span>
              <span class="text-ink-mute font-mono text-sm tabular-nums">{row.version}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</section>
