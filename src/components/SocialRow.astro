---
import SocialIcon, { type SocialId } from './SocialIcon.astro';
import { useTranslations, type Lang } from '../i18n/ui';

/**
 * The real destinations, each with its icon AND its text label. There is
 * deliberately no Facebook, no Mastodon and no LinkedIn placeholder: a link that
 * goes nowhere is worse than an absent one.
 *
 * WeChat has no URL — both WeChat entries are QR images — so they render as
 * disclosures instead of anchors: the personal account and the Official Account,
 * told apart by their labels. Open/close is native `<details>`; the layout adds
 * Escape, outside-click and one-open-at-a-time on top, so the controls still work
 * with scripting off.
 */
interface Props {
  lang: Lang;
  /** Which side of the trigger the QR panel opens on. */
  placement?: 'below' | 'above';
  class?: string;
}

const { lang, placement = 'above', class: className = '' } = Astro.props;
const t = useTranslations(lang);

const links: { id: Exclude<SocialId, 'wechat'>; href: string; label: string }[] = [
  { id: 'github', href: 'https://github.com/sunerpy', label: t('social.github') },
  { id: 'bilibili', href: 'https://space.bilibili.com/35507467', label: t('social.bilibili') },
  { id: 'zhihu', href: 'https://www.zhihu.com/people/bluer-ain', label: t('social.zhihu') },
  { id: 'x', href: 'https://x.com/sunerpy', label: t('social.x') },
];

const qrs = [
  {
    src: '/wechat-qr.jpg',
    label: t('social.wechat'),
    caption: t('social.wechat.caption'),
    alt: t('social.wechat.alt'),
  },
  {
    src: '/wechat-official-account.jpg',
    label: t('social.wechatOa'),
    caption: t('social.wechatOa.caption'),
    alt: t('social.wechatOa.alt'),
  },
];

const itemClass =
  'text-ink-body hover:text-accent inline-flex items-center gap-2.5 py-1 text-sm no-underline';

// The panel opens upward on wide screens, but goes IN-FLOW on mobile: the footer is
// a single column there, so an upward overlay would land on the links stacked
// above the trigger. Expanding in place pushes them instead of hiding them.
const panelPosition =
  placement === 'below'
    ? 'absolute top-[calc(100%_+_0.625rem)] left-0 w-[13.5rem]'
    : 'mt-2.5 w-[13.5rem] max-w-full sm:absolute sm:bottom-[calc(100%_+_0.625rem)] sm:left-0 sm:mt-0';
---

<ul class={`flex flex-col gap-1 ${className}`}>
  {
    links.map((link) => (
      <li>
        <a href={link.href} target="_blank" rel="noopener noreferrer" class={itemClass}>
          <SocialIcon id={link.id} />
          <span>{link.label}</span>
        </a>
      </li>
    ))
  }

  {
    qrs.map((qr) => (
      <li class="relative">
        <details data-popover>
          <summary class={itemClass}>
            <SocialIcon id="wechat" />
            <span>{qr.label}</span>
          </summary>

          <div class={`u-popover ${panelPosition} z-30 p-3`}>
            {/* A QR needs a light ground to scan in either theme, so the plate is
                white regardless of colour scheme — a scanner requirement, not a
                styling slip. */}
            <img
              src={qr.src}
              alt={qr.alt}
              width="430"
              height="430"
              loading="lazy"
              decoding="async"
              class="block w-full rounded-[var(--radius-chip)] bg-white"
            />
            <p class="text-ink-mute mt-2.5 text-center text-xs">{qr.caption}</p>
          </div>
        </details>
      </li>
    ))
  }
</ul>
