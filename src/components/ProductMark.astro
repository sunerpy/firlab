---
/**
 * ProductMark — inline SVG marks. Inline rather than <img> so each mark can
 * inherit theme colour via currentColor while keeping the brand orange on the
 * facets, and so the page still makes zero extra network requests.
 *
 * The AgentLens hexagon and the Voxera chevron are lifted from the shipped
 * application icons (icons/source/*.svg in each repo) so the marks here match
 * the marks on the user's dock. CodeGraph has no icon yet, so its mark is a
 * three-node graph drawn to the same geometric language.
 */
interface Props {
  product: 'codegraph' | 'agentlens' | 'voxera';
  /** Rendered size in px. */
  size?: number;
  class?: string;
}

const { product, size = 44, class: className = '' } = Astro.props;

const label = {
  codegraph: 'CodeGraph mark',
  agentlens: 'AgentLens mark',
  voxera: 'Voxera mark',
}[product];
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  role="img"
  aria-label={label}
  class={`shrink-0 ${className}`}
>
  {
    product === 'codegraph' && (
      <>
        {/* Deterministic graph: three symbols, resolved edges. */}
        <path
          d="M12 12 L36 20 M12 12 L20 36 M36 20 L20 36"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="square"
          opacity="0.55"
        />
        <circle cx="12" cy="12" r="4.5" fill="var(--color-mark)" />
        <circle cx="36" cy="20" r="3.25" fill="currentColor" />
        <circle cx="20" cy="36" r="3.25" fill="currentColor" />
      </>
    )
  }
  {
    product === 'agentlens' && (
      <>
        {/* Pointy-top hexagon, three facets — from src-tauri/icons/source/icon.svg */}
        <path d="M24 3.5 L4.6 14.7 L4.6 37.1 L24 48.3 Z" fill="currentColor" opacity="0.16" />
        <path d="M24 3.5 L43.4 14.7 L43.4 24 L24 24 Z" fill="var(--color-mark)" />
        <path
          d="M24 3.5 L43.4 14.7 L43.4 37.1 L24 48.3 L4.6 37.1 L4.6 14.7 Z M24 3.5 L24 48.3 M24 24 L43.4 24"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linejoin="round"
        />
      </>
    )
  }
  {
    product === 'voxera' && (
      <>
        {/* Split V — from apps/desktop/icons/source/voxera-app.svg, plate removed. */}
        <path d="M6 8 L22.1 43 L24 43 L24 22 L17 8 Z" fill="currentColor" opacity="0.5" />
        <path d="M42 8 L25.9 43 L24 43 L24 22 L31 8 Z" fill="var(--color-mark)" />
      </>
    )
  }
</svg>
