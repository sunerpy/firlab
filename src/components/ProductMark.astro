---
/**
 * ProductMark — inline SVG marks. Inline rather than <img> so each mark can
 * inherit theme colour via currentColor while keeping the brand orange on the
 * facets, and so the page still makes zero extra network requests.
 *
 * The AgentLens hexagon and the Voltip split V are lifted from the shipped
 * application icons (AgentLens icons/source/*.svg, Voltip's Logo component) so
 * the marks here match the marks on the user's dock. pt-tools is lifted from brand/pt-tools/logo.svg
 * for the same reason — regenerate that first, then port the geometry here.
 * CodeGraph has no icon yet, so its three-node graph is drawn to the same
 * geometric language.
 */
interface Props {
  product: 'pttools' | 'codegraph' | 'agentlens' | 'voltip';
  /** Rendered size in px. */
  size?: number;
  class?: string;
}

const { product, size = 44, class: className = '' } = Astro.props;

const label = {
  pttools: 'pt-tools mark',
  codegraph: 'CodeGraph mark',
  agentlens: 'AgentLens mark',
  voltip: 'Voltip mark',
}[product];
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  role="img"
  aria-label={label}
  class={`shrink-0 ${className}`}
>
  {
    product === 'pttools' && (
      <>
        {/* A shell prompt caret and the cursor block after it — from
            brand/pt-tools/logo.svg, plate removed, that mark's 16ths scaled by 3.
            pt-tools is a CLI, and this is what a terminal line looks like before
            you type. The 6-unit stroke is heavy on purpose: it IS the element
            rather than an outline of one, and a sibling-weight 1.75 hairline
            would vanish at these sizes. The 6-unit gap is the meaning — two
            tokens on a command line — so it must not close up. No opacity, so
            neither half can degrade into a ghost. */}
        <path
          d="M9 15 L18 24 L9 33"
          stroke="currentColor"
          stroke-width="6"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <rect x="27" y="18" width="15" height="12" fill="var(--color-mark)" />
      </>
    )
  }
  {
    product === 'codegraph' && (
      <>
        {/* Deterministic graph: three symbols, resolved edges. */}
        <path
          d="M12 12 L36 20 M12 12 L20 36 M36 20 L20 36"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="square"
          opacity="0.55"
        />
        <circle cx="12" cy="12" r="4.5" fill="var(--color-mark)" />
        <circle cx="36" cy="20" r="3.25" fill="currentColor" />
        <circle cx="20" cy="36" r="3.25" fill="currentColor" />
      </>
    )
  }
  {
    product === 'agentlens' && (
      <>
        {/* Pointy-top hexagon, three facets — from src-tauri/icons/source/icon.svg */}
        <path d="M24 3.5 L4.6 14.7 L4.6 37.1 L24 48.3 Z" fill="currentColor" opacity="0.16" />
        <path d="M24 3.5 L43.4 14.7 L43.4 24 L24 24 Z" fill="var(--color-mark)" />
        <path
          d="M24 3.5 L43.4 14.7 L43.4 37.1 L24 48.3 L4.6 37.1 L4.6 14.7 Z M24 3.5 L24 48.3 M24 24 L43.4 24"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linejoin="round"
        />
      </>
    )
  }
  {
    product === 'voltip' && (
      <>
        {/* Split V — from voltip packages/ui/src/components/Logo.tsx (100-unit
            viewBox), plate removed, scaled by 0.614 about the centre line. The
            pale left arm becomes currentColor at half strength so it follows the
            theme; the orange right arm keeps the brand mark. */}
        <path d="M7.1 8 L17.55 8 L24 22.7 L24 43 Z" fill="currentColor" opacity="0.5" />
        <path d="M30.45 8 L40.9 8 L24 43 L24 22.7 Z" fill="var(--color-mark)" />
      </>
    )
  }
</svg>
