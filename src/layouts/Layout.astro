---
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import '../styles/global.css';
import {
  useTranslations,
  stripLocale,
  htmlLang,
  ogLocale,
  languages,
  defaultLang,
  type Lang,
} from '../i18n/ui';

/**
 * Base layout. Every head tag is props-driven so each locale — and later, each
 * product detail page — reuses this without inheriting the home page's metadata.
 *
 * Locale handling:
 *   - `<html lang>` carries the real BCP 47 tag (`zh-CN`), not the Astro locale
 *     id (`zh-cn`). The CSS script metrics key off `:lang(zh-CN)`.
 *   - Each document is self-canonical. Canonicalising both locales onto one URL
 *     would tell crawlers the translation is a duplicate.
 *   - `hreflang` alternates are emitted in both directions plus `x-default`,
 *     which points at the Chinese root: that is the site's primary audience and
 *     the URL already indexed at the apex.
 *
 * JSON-LD models a `Person` publishing a `WebSite`, not an `Organization`.
 * FirLab is one person's project umbrella; asserting a company would be false
 * structured data. `sameAs` is where the social profiles are declared.
 */
interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path to the social card, relative to the site root. */
  ogImage?: string;
  ogImageAlt: string;
  /** Extra JSON-LD graph nodes to emit alongside the site and person nodes. */
  structuredData?: Record<string, unknown>[];
}

const {
  lang,
  title,
  description,
  ogImage = '/og.png',
  ogImageAlt,
  structuredData = [],
} = Astro.props;

const t = useTranslations(lang);

const slug = stripLocale(Astro.url.pathname);
const canonical = getAbsoluteLocaleUrl(lang, slug);
const ogImageUrl = new URL(ogImage, Astro.site);

const alternates = (Object.keys(languages) as Lang[]).map((code) => ({
  hreflang: htmlLang[code],
  href: getAbsoluteLocaleUrl(code, slug),
}));
const xDefault = getAbsoluteLocaleUrl(defaultLang, slug);

const person = {
  '@type': 'Person',
  '@id': 'https://firlab.app/#sunerpy',
  name: 'sunerpy',
  url: 'https://github.com/sunerpy',
  sameAs: [
    'https://github.com/sunerpy',
    'https://space.bilibili.com/35507467',
    'https://www.zhihu.com/people/bluer-ain',
    'https://x.com/sunerpy',
  ],
};

const website = {
  '@type': 'WebSite',
  '@id': 'https://firlab.app/#website',
  name: 'FirLab',
  url: 'https://firlab.app',
  description,
  inLanguage: htmlLang[lang],
  publisher: { '@id': 'https://firlab.app/#sunerpy' },
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [website, person, ...structuredData],
};
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />

    {/* SVG first — modern browsers prefer it and it carries the theme-aware
        spine colour. The 512px PNG is the raster fallback for clients that
        ignore SVG icons; it is monochrome brand orange so it reads on both a
        light and a dark tab strip. */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />

    <meta property="og:site_name" content="FirLab" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {
      (Object.keys(languages) as Lang[])
        .filter((code) => code !== lang)
        .map((code) => <meta property="og:locale:alternate" content={ogLocale[code]} />)
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <meta name="author" content="sunerpy" />
    <meta name="theme-color" content="#fbfcfe" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#080d16" media="(prefers-color-scheme: dark)" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>

  <body class="bg-paper text-ink-body min-h-dvh antialiased">
    <a
      href="#main"
      class="focus-visible:bg-paper focus-visible:border-rule focus-visible:text-ink sr-only focus-visible:not-sr-only focus-visible:fixed focus-visible:top-3 focus-visible:left-3 focus-visible:z-50 focus-visible:rounded-[6px] focus-visible:border focus-visible:px-3 focus-visible:py-2 focus-visible:no-underline"
    >
      {t('nav.skipToContent')}
    </a>

    <div class="u-progress" aria-hidden="true"></div>

    <div class="u-guides" aria-hidden="true"></div>

    <div class="relative z-10">
      <slot />
    </div>

    {/*
      Announcement target for the copy affordance. Empty in the served HTML and
      only ever written by the script below, so a scripting-off client renders
      nothing here.
    */}
    <p class="sr-only" role="status" aria-live="polite" data-copy-status></p>

    {/*
      The only script on the site, and it does exactly two things the platform
      has no declarative equivalent for.

      1. `<details>` already gives the WeChat QR a working open/close and full
         keyboard support with scripting off; this adds Escape-to-dismiss and
         click-outside-to-dismiss.
      2. The copy buttons in command blocks. They ship `display: none` and are
         only revealed once `navigator.clipboard.writeText` is confirmed to
         exist — an affordance that cannot work must never be drawn. The command
         itself is always selectable text in a `<code>`, so copying never
         *depends* on this.

      Inline, so it still costs no request and `<script src>` stays at zero.
    */}
    <script is:inline>
      (function () {
        var panels = document.querySelectorAll('details[data-popover]');
        if (!panels.length) return;

        function closeAll(except) {
          panels.forEach(function (panel) {
            if (panel !== except) panel.open = false;
          });
        }

        panels.forEach(function (panel) {
          panel.addEventListener('toggle', function () {
            if (panel.open) closeAll(panel);
          });
        });

        document.addEventListener('click', function (event) {
          panels.forEach(function (panel) {
            if (panel.open && !panel.contains(event.target)) panel.open = false;
          });
        });

        document.addEventListener('keydown', function (event) {
          if (event.key !== 'Escape') return;
          panels.forEach(function (panel) {
            if (!panel.open) return;
            panel.open = false;
            var summary = panel.querySelector('summary');
            if (summary) summary.focus();
          });
        });
      })();

      (function () {
        var buttons = document.querySelectorAll('button.u-copy');
        if (!buttons.length) return;
        if (!navigator.clipboard || typeof navigator.clipboard.writeText !== 'function') return;

        var status = document.querySelector('[data-copy-status]');
        var timers = new WeakMap();

        function settle(button, state, message) {
          var text = button.querySelector('[data-copy-text]');
          button.setAttribute('data-state', state);
          if (text) text.textContent = message;
          if (status) status.textContent = message;

          clearTimeout(timers.get(button));
          timers.set(
            button,
            setTimeout(function () {
              button.removeAttribute('data-state');
              if (text) text.textContent = button.getAttribute('data-idle') || '';
              if (status) status.textContent = '';
            }, 2200),
          );
        }

        buttons.forEach(function (button) {
          button.setAttribute('data-ready', '');

          button.addEventListener('click', function () {
            navigator.clipboard.writeText(button.getAttribute('data-copy') || '').then(
              function () {
                settle(button, 'done', button.getAttribute('data-done') || '');
              },
              function () {
                settle(button, 'failed', button.getAttribute('data-failed') || '');
              },
            );
          });
        });
      })();
    </script>
  </body>
</html>
