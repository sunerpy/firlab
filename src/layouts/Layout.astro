---
import '../styles/global.css';

/**
 * Base layout. Every head tag is props-driven so a second page can reuse this
 * without inheriting the landing page's metadata.
 *
 * JSON-LD deliberately omits `offers` and `aggregateRating`: there is no
 * pricing and there are no reviews, and inventing either would be structured-
 * data spam.
 */
interface Props {
  title: string;
  description: string;
  /** Path to the social card, relative to the site root. */
  ogImage?: string;
  /** Extra JSON-LD graph nodes to emit alongside the Organization node. */
  structuredData?: Record<string, unknown>[];
}

const {
  title,
  description,
  ogImage = '/og.png',
  structuredData = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);

const organization = {
  '@type': 'Organization',
  '@id': 'https://firlab.app/#firlab',
  name: 'FirLab',
  url: 'https://firlab.app',
  description:
    'FirLab is the project umbrella for local-first developer tools built by Shaonan Zhang.',
  founder: {
    '@type': 'Person',
    name: 'Shaonan Zhang',
    url: 'https://github.com/sunerpy',
  },
  sameAs: ['https://github.com/sunerpy'],
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [organization, ...structuredData],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* SVG first — modern browsers prefer it and it carries the theme-aware
        spine colour. The 512px PNG is the raster fallback for clients that
        ignore SVG icons; it is monochrome brand orange so it reads on both a
        light and a dark tab strip. */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />

    <meta property="og:site_name" content="FirLab" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="FirLab — developer tools by Shaonan Zhang" />
    <meta property="og:locale" content="en" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="author" content="Shaonan Zhang" />
    <meta name="theme-color" content="#fbfcfe" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#080d16" media="(prefers-color-scheme: dark)" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>

  <body class="bg-paper text-ink-body min-h-dvh antialiased">
    <slot />
  </body>
</html>
